#: src/UI/OnboardingHintPanel.cs
msgid "tutorial.title"
msgstr "DAY 1 OBJECTIVE"

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.protocol.title"
msgstr "Resolve the Day 1 protocol"

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.protocol.objective"
msgstr "Handle rationing, maintenance, then radio. Each choice costs something."

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.inspect.title"
msgstr "Inspect three bunker rooms"

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.inspect.objective"
msgstr "Open the shelter and inspect rooms until three have confirming notes."

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.rationing.title"
msgstr "Open the stores and read them"

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.rationing.objective"
msgstr "Open the inventory and look at the food and water you are rationing."

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.assignment.title"
msgstr "Assign a survivor to a duty"

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.assignment.objective"
msgstr "Open the duty roster and assign one survivor to a shift. Survivors cannot work without one."

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.weather.title"
msgstr "Read the weather"

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.weather.objective"
msgstr "Open the weather forecast or panel to learn what tomorrow will bring."

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.inventory.title"
msgstr "Use an item from the stores"

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.inventory.objective"
msgstr "Equip protection, or use something from stores."

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.day_advance.title"
msgstr "End Day 1"

#: Assets/Ashfall.Core/Onboarding/OnboardingJourney.cs
msgid "tutorial.day_advance.objective"
msgstr "Confirm Advance Day. Morning briefing comes with Day 2."

#: Assets/Ashfall.Core/Radiation/RadiationSystem.cs
msgid "warning.radiation.acute"
msgstr "ACUTE RADIATION: {0} at {1:F0} mSv (-5 HP/h). Give Rad-Away or iodine."

#: Assets/Ashfall.Core/Localization/LocalizationService.cs
msgid "warning.radiation.storm"
msgstr "FALLOUT STORM: Outdoor dose is rising. Keep people inside or kit them in hazmat."

#: Assets/Ashfall.Core/Survivors/NeedsSystem.cs
msgid "warning.water.low"
msgstr "WATER LOW: {0:F1} units left (~{1:F1} days). Run filtration or desalination."

#: Assets/Ashfall.Core/Survivors/NeedsSystem.cs
msgid "warning.food.low"
msgstr "FOOD LOW: {0:F1} units left (~{1:F1} days). Tighten rations or scavenge."

#: Assets/Ashfall.Core/Shelter/PowerGridSystem.cs
msgid "warning.power.brownout"
msgstr "POWER DEFICIT: Generator reserve is gone. Filters are offline; indoor contamination is rising."

#: Assets/Ashfall.Core/Survivors/NeedsSystem.cs
msgid "warning.survivor.critical"
msgstr "SURVIVOR IN DANGER: {0} is critical on {1}. Triage now."

#: src/UI/JournalPanel.cs
msgid "codex.manual.title"
msgstr "FIELD SURVIVAL MANUAL"

#: src/UI/JournalPanel.cs
msgid "codex.manual.radiation"
msgstr "Radiation: Dose climbs in fallout and storms. Above 50 mSv, acute sickness takes 5 HP/hr. Give Rad-Away or iodine."

#: src/UI/JournalPanel.cs
msgid "codex.manual.rations"
msgstr "Rations: Three people drink ~3.6 clean water a day. Keep filtration membranes working."

#: src/UI/JournalPanel.cs
msgid "codex.manual.power"
msgstr "Power: Air filtration needs a live grid. Stock batteries and generator fuel."

#: src/UI/JournalPanel.cs
msgid "codex.manual.duty"
msgstr "Duty: Unassigned people lose morale and cannot keep rooms running."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_roadside_memorial.title"
msgstr "Roadside Memorial"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_roadside_memorial.description"
msgstr "Melted tallow stubs sit inside rusted rationing tins around a bent highway marker. A photograph was torn away, leaving only a bloodstained corner pinned beneath a stone. The wax has frozen into pale, grey discs, and the tins have been set in a rough circle."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_roadside_memorial.choice.leave_memorial"
msgstr "Leave it untouched."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_roadside_memorial.choice.take_offering"
msgstr "Take the candle stubs and any small offering left behind."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_crashed_truck.title"
msgstr "Crashed Supply Truck"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_crashed_truck.description"
msgstr "A military logistics rig lies crushed in the frozen ditch, its windshield shattered outward. Torn radiation warning tags cling to the twisted rear doors. The cargo area was scavenged long ago, but one crate lies split open in the frost, and nobody has closed it."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_crashed_truck.choice.search_truck_cargo"
msgstr "Search the split crate and cab for salvage."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_crashed_truck.choice.search_truck_cab"
msgstr "Investigate the cab for documents or personal effects."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_crashed_truck.choice.ignore_truck"
msgstr "Move on. Someone already took what was worth taking."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_frozen_bus.title"
msgstr "Frozen Evacuation Bus"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_frozen_bus.description"
msgstr "The transit doors are frozen wide open, letting the ash-laden wind howl through the cabin. A child's single shoe sits upright beneath a luggage rack. The windows are obscured by thick, greasy frost on the inside, and nothing has been wiped clear."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_frozen_bus.choice.search_bus_luggage"
msgstr "Search the luggage rack for supplies."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_frozen_bus.choice.leave_bus"
msgstr "Leave the bus undisturbed."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_frozen_bus.choice.read_bus_tag"
msgstr "Check the transit tag on the dashboard for a destination."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_improvised_grave.title"
msgstr "Improvised Grave"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_improvised_grave.description"
msgstr "A shallow mound of frozen earth, hastily reinforced with chunks of shattered concrete. A name is violently gouged into a piece of broken siding, along with a date from the first winter of the ashfall, and both are cut to the same depth."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_improvised_grave.choice.respect_grave"
msgstr "Pay respects and move on."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_improvised_grave.choice.inspect_grave_marker"
msgstr "Read the name and date scratched into the plank."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_improvised_grave.choice.disturb_grave"
msgstr "Check beneath the stones for any buried belongings."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_collapsed_bridge.title"
msgstr "Collapsed Bridge"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_collapsed_bridge.description"
msgstr "A colossal span of reinforced concrete leans broken into the black, freezing river. A transport vehicle is wedged violently against the submerged rebar, its rear doors hanging open just above the roaring current."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_collapsed_bridge.choice.search_bridge_vehicle"
msgstr "Climb down to the wedged vehicle and search the cargo area."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_collapsed_bridge.choice.inspect_bridge_structure"
msgstr "Examine the collapsed span for salvageable steel or cable."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_collapsed_bridge.choice.avoid_bridge"
msgstr "Find a way around. The structure looks unstable."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_drainage_pipe.title"
msgstr "Drainage Pipe"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_drainage_pipe.description"
msgstr "Rags and irradiated blankets have been pushed deep into this dark concrete culvert. Words are gouged into the wall just beyond the reach of the freezing rain, the letters uneven and going downhill. The smell of copper and unwashed bodies lingers, and the blankets lie well back from the drip."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_drainage_pipe.choice.crawl_pipe"
msgstr "Crawl inside and check the blankets for supplies."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_drainage_pipe.choice.read_pipe_warning"
msgstr "Read the warning scratched into the concrete."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_drainage_pipe.choice.ignore_pipe"
msgstr "Leave it alone. Someone may come back."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_rail_siding.title"
msgstr "Rail Siding"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_rail_siding.description"
msgstr "Rusted wheelsets have sunk deep into the irradiated ballast. A maintenance ledger hangs from the side of a derailed freight car, the final pages written in frantic, shaky handwriting before ending abruptly, and the ledger has not been moved."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_rail_siding.choice.search_rail_car"
msgstr "Search the freight car for industrial salvage."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_rail_siding.choice.read_rail_ledger"
msgstr "Read the maintenance ledger."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_rail_siding.choice.ignore_rail"
msgstr "The car has been picked over. Move on."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_dead_livestock.title"
msgstr "Dead Livestock Area"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_dead_livestock.description"
msgstr "Plastic ear tags flutter in the ash-wind among the dead weeds. Massive, bloated bodies of livestock were dragged into a rough trench, but the grave diggers abandoned the work. The Geiger counter stutters nervously here."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_dead_livestock.choice.scavenge_livestock"
msgstr "Scavenge usable material from the remains."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_dead_livestock.choice.inspect_livestock_tags"
msgstr "Inspect the ear tags for farm identification."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_dead_livestock.choice.avoid_livestock"
msgstr "Keep your distance. The contamination risk is not worth it."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_ruined_greenhouse.title"
msgstr "Ruined Greenhouse"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_ruined_greenhouse.description"
msgstr "Shattered glass crunches underfoot in this ruined greenhouse. Desiccated seed trays lie beneath the rusted benches. In the corner, a heavy steel cabinet remains sealed—the paint around its lock is scarred by crowbar marks that stop short of success, and the scars are old."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_ruined_greenhouse.choice.take_greenhouse_seeds"
msgstr "Take the labeled seed trays."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_ruined_greenhouse.choice.open_greenhouse_cabinet"
msgstr "Force the sealed cabinet open."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_ruined_greenhouse.choice.leave_greenhouse"
msgstr "Leave the greenhouse for whoever finds it next."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_shell_crater.title"
msgstr "Shell Crater"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_shell_crater.description"
msgstr "The blast fused the earth into dark, jagged glass along one side of the massive crater. A torn military harness and scorched metal fragments are fused into the soil. Stepping near the rim, each footfall lands with a hollow knock that carries further than it should."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_shell_crater.choice.inspect_crater"
msgstr "Carefully inspect the crater edge for salvage."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_shell_crater.choice.salvage_crater_harness"
msgstr "Dig out the harness and stamped metal fragments."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_shell_crater.choice.avoid_crater"
msgstr "The ground is unstable. Walk around."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_field_kitchen.title"
msgstr "Abandoned Field Kitchen"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_field_kitchen.description"
msgstr "A massive cast-iron cooking pot is frozen solid to its metal stand. Bent ladles hang from rusted wire hooks. Hundreds of tally marks are gouged into the serving table, five bars to a group, tracking rations that eventually ran out."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_field_kitchen.choice.search_kitchen"
msgstr "Search the kitchen area for preserved food or fuel."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_field_kitchen.choice.take_kitchen_tools"
msgstr "Take the ladles and cooking implements."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_field_kitchen.choice.read_ration_marks"
msgstr "Read the ration marks scratched into the table."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_generator.title"
msgstr "Abandoned Generator"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_generator.description"
msgstr "The heavy generator casing is wrenched open, its primary power cables severed with surgical precision. A frantic fuel mixture ratio is scrawled in grease pencil on the frame. The heavy block is dead, but it could be salvaged."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_generator.choice.strip_generator"
msgstr "Strip the generator for electrical components."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_generator.choice.read_generator_notes"
msgstr "Copy the fuel mixture notes from the frame."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_generator.choice.mark_generator"
msgstr "Mark the location for a future salvage team."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_shrine.title"
msgstr "Roadside Shrine"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_shrine.description"
msgstr "Tallow candles have burned down to stubs inside a rusted ration tin. Small offerings—screws, shiny pebbles, a bullet—sit beneath a faded cloth carefully knotted around the twisted guardrail."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_shrine.choice.leave_shrine"
msgstr "Leave the shrine undisturbed."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_shrine.choice.take_shrine_offerings"
msgstr "Take the small offerings left beneath the cloth."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_shrine.choice.add_shrine_offering"
msgstr "Leave a small offering of your own."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_emergency_cache.title"
msgstr "Emergency Cache"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_emergency_cache.description"
msgstr "The rubber weather seal has cracked in the bitter cold, but the faded stencil is undeniable. Deep gouges show where someone tried to pry the heavy lock before abandoning it. It reads: CIVIL DEFENSE — EMERGENCY RATION CACHE."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_emergency_cache.choice.open_cache"
msgstr "Force the cracked seal and open the cache."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_emergency_cache.choice.leave_cache"
msgstr "Leave the cache sealed. Someone may need it more."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_observation_post.title"
msgstr "Military Observation Post"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_observation_post.description"
msgstr "A heavy optics mount still points silently toward the desolate crossing below. Frantic grid references and kill-counts are scrawled on the concrete wall, stopping abruptly mid-sentence. A single spent sniper cartridge sits on the frozen windowsill."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_observation_post.choice.search_observation_post"
msgstr "Search the post for optics or intelligence documents."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_observation_post.choice.read_grid_references"
msgstr "Copy the grid references and dates from the wall."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_observation_post.choice.ignore_observation_post"
msgstr "The post has been stripped. Move on."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_barricade.title"
msgstr "Abandoned Barricade"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_barricade.description"
msgstr "Traffic arrows were repainted twice in different faction colors, marking shifting territories. A mummified corpse lies slumped behind the barrier, clutching a rusted lockbox. The sandbags have frozen into a solid, bullet-pocked wall."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_barricade.choice.search_barricade"
msgstr "Search the barricade for supplies left behind."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_barricade.choice.read_barricade_markings"
msgstr "Examine the faction markings on the barricade."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_barricade.choice.avoid_barricade"
msgstr "Circle around. The body suggests this was not a safe place."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_hunting_blind.title"
msgstr "Hunting Blind"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_hunting_blind.description"
msgstr "Half of the camouflage blind has collapsed under the weight of radioactive ash. An empty thermos, scattered brass casings, and a cloth-wrapped journal lie abandoned under the bench. The damp pages chronicle a hunt that went terribly wrong."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_hunting_blind.choice.search_blind"
msgstr "Search the blind for hunting supplies."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_hunting_blind.choice.read_blind_journal"
msgstr "Read the damp journal."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_hunting_blind.choice.leave_blind"
msgstr "Leave the blind as you found it."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_radio_tower.title"
msgstr "Damaged Radio Tower"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_radio_tower.description"
msgstr "The towering mast has buckled, its twisted steel groaning in the wind. A single intact feed line snakes into a heavy, locked utility cabinet at the base. The metal door is scarred with deep claw marks."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_radio_tower.choice.open_radio_cabinet"
msgstr "Force the cabinet open and salvage the components."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_radio_tower.choice.read_radio_log"
msgstr "Check the cabinet for a frequency log or maintenance record."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_radio_tower.choice.ignore_radio"
msgstr "The tower is beyond repair. Move on."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_destroyed_checkpoint.title"
msgstr "Destroyed Checkpoint"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_destroyed_checkpoint.description"
msgstr "Heavy concrete barriers are scorched black on the side facing the bunker, suggesting whatever attacked came from within. A blood-spattered logbook is pinned beneath a collapsed steel chair. The faction identity plate has been violently torn away."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_destroyed_checkpoint.choice.search_checkpoint"
msgstr "Search the checkpoint for confiscated goods or supplies."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_destroyed_checkpoint.choice.read_checkpoint_log"
msgstr "Read the logbook beneath the chair."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_destroyed_checkpoint.choice.avoid_checkpoint"
msgstr "The destruction suggests heavy fighting. Keep moving."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_tent.title"
msgstr "Abandoned Tent"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_tent.description"
msgstr "The military-grade fabric has collapsed under the weight of grey snow. Inside, nested tin cups sit beside a child's crayon drawing, meticulously preserved in a plastic sleeve. The tent's zipper is frozen shut from the inside."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_tent.choice.search_tent"
msgstr "Cut open the tent and search for supplies."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_tent.choice.take_drawing"
msgstr "Take the child's drawing from the plastic sleeve."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_abandoned_tent.choice.leave_tent"
msgstr "Leave the tent undisturbed."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_makeshift_clinic.title"
msgstr "Makeshift Clinic"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_makeshift_clinic.description"
msgstr "Desperate triage categories are scrawled in blood on torn cardboard strips. Empty, frozen saline bags hang from a rusted IV cable. The medicine cabinet was ransacked—some shelves stripped bare while others were ignored entirely."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_makeshift_clinic.choice.search_clinic"
msgstr "Search the untouched shelves for medical supplies."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_makeshift_clinic.choice.read_triage_list"
msgstr "Read the triage numbers on the cardboard strips."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_makeshift_clinic.choice.leave_clinic"
msgstr "Leave the clinic intact. Others may need it."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_crashed_drone.title"
msgstr "Crashed Drone"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_crashed_drone.description"
msgstr "One shattered wing is driven deep into the frozen earth. The outer casing was ripped open by scavengers, but the armored flight-control compartment remains sealed. Corrosive battery acid has burned a dark, hissing stain into the soil."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_crashed_drone.choice.open_drone_compartment"
msgstr "Force open the flight-control compartment."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_crashed_drone.choice.read_drone_log"
msgstr "Attempt to extract the flight log from the sealed compartment."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_crashed_drone.choice.avoid_drone"
msgstr "The battery acid suggests chemical risk. Leave it."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_fuel_cache.title"
msgstr "Fuel Cache"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_fuel_cache.description"
msgstr "Two military drums are half-buried beneath a rusted sheet of corrugated metal. A desperate route map to a safe zone has been scratched into one lid with a nail. The drums are heavy, their tamper-seals unbroken."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_fuel_cache.choice.take_fuel_cache"
msgstr "Dig up the containers and take the fuel."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_fuel_cache.choice.read_route_sketch"
msgstr "Copy the route sketch from the lid."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_fuel_cache.choice.leave_fuel_cache"
msgstr "Leave the cache hidden. You may need it later."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_water_source.title"
msgstr "Water Source"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_water_source.description"
msgstr "A dented tin cup is bound to the rusted hand pump with frayed wire, the concrete basin stained with heavy, unnatural mineral deposits. Someone wrote 'SAFE' in charcoal, alongside a date from five years ago. The pump handle still groans when moved."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_water_source.choice.collect_water"
msgstr "Pump and collect water from the source."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_water_source.choice.test_water"
msgstr "Test the water quality before collecting."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_water_source.choice.avoid_water"
msgstr "The mineral staining is suspicious. Move on."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_supply_drop.title"
msgstr "Supply Drop"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_supply_drop.description"
msgstr "The faded military parachute is hopelessly tangled in the black, petrified branches of dead trees. The stenciled coordinates indicate it drifted miles off course. The reinforced crate is intact, but the heavy locking seal has been severed."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_supply_drop.choice.open_supply_drop"
msgstr "Open the crate and take what is inside."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_supply_drop.choice.read_supply_label"
msgstr "Read the shipping label for destination and origin information."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_supply_drop.choice.leave_supply_drop"
msgstr "Leave the crate. It was meant for someone else."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_hospital_chapel_ledger.title"
msgstr "Hospital Chapel Ledger"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_hospital_chapel_ledger.description"
msgstr "The chapel beside the east wing kept a visitors' ledger through the worst of it. The last entries are names, then bed numbers, then nothing at all — just a date repeated down the page in a steady hand until the hand stopped coming. A candle box under the stand still has three stubs and a packet of matches."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_hospital_chapel_ledger.choice.read_the_names"
msgstr "Read the last page properly, then close the ledger."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_hospital_chapel_ledger.choice.take_matches"
msgstr "Take the lighter from the candle box. The dead do not need light."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_depot_undertow_raft_line.title"
msgstr "Undertow Raft Line"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_depot_undertow_raft_line.description"
msgstr "A raft of sealed crates lashed to a handrail runs down the flooded concourse, marked with the Undertow's tar-symbol. The line is rigged to a pulley someone greased recently. Whatever moves along it moves quietly, and often."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_depot_undertow_raft_line.choice.note_the_route"
msgstr "Mark the pulley anchors on your map and leave the line alone."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_depot_undertow_raft_line.choice.cut_one_crate"
msgstr "Cut one crate free before the owners notice."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_gamma_levy_board.title"
msgstr "Checkpoint Gamma Levy Board"

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_gamma_levy_board.description"
msgstr "The garrison's levy board still stands by the guard shack: grain quotas, diesel quotas, and the names of households marked square for paid and circle for owed. Fresh chalk over old chalk. Somebody drives here to write, which means somebody still collects."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_gamma_levy_board.choice.memorize_the_board"
msgstr "Memorize which farms have paid and which are marked owed."

#: Assets/StreamingAssets/Data/micro_locations.json
msgid "discovery.micro_gamma_levy_board.choice.take_the_chalk"
msgstr "Take the chalk and the board's rating stamp. Forged square marks might pass at a distance."


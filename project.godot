; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text.

config_version=5

[application]

config/name="ASHFALL: Atomic War - Starving Survival"
config/description="Post-nuclear survival strategy RPG"
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Compatibility")
config/icon="res://icon.svg"
run/max_fps=60

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
# Required for headless mode compatibility
window/size/mode=4
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/stretch/scale_mode="fractional"
window/dpi/allow_hidpi=true

[dotnet]

project/assembly_name="Ashfall"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=false

[gui]

theme/custom_font="res://assets/fonts/BarlowCondensed-Regular.ttf"
theme/custom_font_size=15
theme/custom_font_mono="res://assets/fonts/ShareTechMono-Regular.ttf"

[input]


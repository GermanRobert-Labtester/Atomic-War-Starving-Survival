  "doctrines": [
    {
      "id": "warlord_doctrine_toll",
      "display_name": "The Toll",
      "description": "The boom is up and the price is known, same as last week, same as next week, higher if you make it higher. The Tollman collects on schedule, files the chits, and lets the road do the arguing. Tribute is not cruelty; it is bookkeeping with teeth. The collector calls once a week, and the collector knows your face.",
      "risk_tolerance": 0.6,
      "preferred_goal": "tribute",
      "eligible_actions": [
        "demand_tribute",
        "raid",
        "defend",
        "contest"
      ],
      "action_weights": {
        "demand_tribute": 4,
        "raid": 3,
        "defend": 2,
        "contest": 1
      },
      "resource_priority": [
        "canned_food",
        "fuel"
      ],
      "target_rule": "nearest_undefended",
      "journal_key": "jrnl_warlord_toll_doctrine",
      "radio_key": "radio_warlord_toll_standing",
      "transitions": [
        {
          "to": "warlord_doctrine_annexation",
          "signal": "success_streak",
          "condition": "gte",
          "threshold": 2
        },
        {
          "to": "warlord_doctrine_consolidation",
          "signal": "failure_streak",
          "condition": "gte",
          "threshold": 2
        },
        {
          "to": "warlord_doctrine_consolidation",
          "signal": "supply_ratio",
          "condition": "lt",
          "threshold": 0.6
        }
      ]
    },
    {
      "id": "warlord_doctrine_consolidation",
      "display_name": "Holding the Line",
      "description": "Fewer booms, more checkpoints, and every checkpoint answers to the same ledger. The Warlords keep what they hold, bleed the road slowly, and make a column pay in patience rather than blood. A road that stops asking questions is a road the Tollman can live with. The ambition is shelved; the lamp stays lit.",
      "risk_tolerance": 0.3,
      "preferred_goal": "stability",
      "eligible_actions": [
        "defend",
        "demand_tribute",
        "contest"
      ],
      "action_weights": {
        "defend": 5,
        "demand_tribute": 2,
        "contest": 1
      },
      "resource_priority": [
        "canned_food",
        "fuel"
      ],
      "target_rule": "nearest_undefended",
      "journal_key": "jrnl_warlord_consolidation_doctrine",
      "radio_key": "radio_warlord_consolidation",
      "transitions": [
        {
          "to": "warlord_doctrine_toll",
          "signal": "supply_ratio",
          "condition": "gte",
          "threshold": 1.2
        },
        {
          "to": "warlord_doctrine_toll",
          "signal": "player_tribute_reliability",
          "condition": "lt",
          "threshold": 0.5
        },
        {
          "to": "warlord_doctrine_withdrawal",
          "signal": "environment_hazard",
          "condition": "gte",
          "threshold": 0.7
        }
      ]
    },
    {
      "id": "warlord_doctrine_annexation",
      "display_name": "The Long Reach",
      "description": "The road is not enough; the ground under it is. The Warlords push claims along the cut and the convoy apron while the taking is cheap, painting checkpoints ahead of the argument. They will call it a land grab. The Tollman calls it a longer price list, and the rates are posted before the ink dries.",
      "risk_tolerance": 0.8,
      "preferred_goal": "expansion",
      "eligible_actions": [
        "annex",
        "contest",
        "raid",
        "demand_tribute"
      ],
      "action_weights": {
        "annex": 4,
        "contest": 3,
        "raid": 2,

  "collector_voice": {
    "demand": [
      "The collector sets the chit on the table and does not let go of it. The number is the number.",
      "A knock, a ledger, and the phrase the whole road knows: 'The Toll House sends its regards.'"
    ],
    "paid": [
      "The collector weighs the cans, nods once, and crosses the line out of the book. 'Until next week.'",
      "Food changes hands, the receipt is carboned twice, and the boom stays up for another week."
    ],
    "short": [
      "The collector counts twice, then writes the shortfall in the remarks column, which is where the dead end up.",
      "The cans are light. The collector says nothing, but the next chit will not be light."
    ],
    "refused": [
      "The collector folds the chit, pockets the pencil, and leaves without a word. The quiet is a signature."
    ]
  },

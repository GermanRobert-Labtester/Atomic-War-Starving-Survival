        {
          "to": "warlord_doctrine_withdrawal",
          "signal": "environment_hazard",
          "condition": "gte",
          "threshold": 0.7
        }
      ]
    },
    {
      "id": "warlord_doctrine_withdrawal",
      "display_name": "Gone to Ground",
      "description": "The lamps are out and the door is locked. Not surrender — arithmetic. The weather has a column of its own and it does not pay tolls, so the Warlords stop answering the road until the freeze lifts. The quiet is the bill, and the bill will come due in the spring, if there is a spring.",
      "risk_tolerance": 0.15,

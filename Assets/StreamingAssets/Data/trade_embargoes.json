      "route_slow_permille": 1000,
      "decay_days": 2
    },
    {
      "rule_id": "embargo_emp_storm_electronics",
      "weather_kind": "EMPStorm",
      "affected_regions": ["foundry"],
      "affected_item_ids": ["electronic_scrap", "solar_cell"],
      "price_multiplier_permille": 2000,
      "caravan_blocked": true,
      "route_slow_permille": 1000,
      "decay_days": 3
    },
    {

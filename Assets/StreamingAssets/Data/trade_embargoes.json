{
  "schema_version": 1,
  "collection_id": "trade_embargoes_14a",
  "description": "Plan 14A commodity embargo rules. Weather-driven trade disruption: route blocking/slowing per region and temporary price surcharges per goods category or item. Every weather_kind resolves to a canonical WeatherKind; every region is a RegionalSupplyRouter supply tag or '*'; every category is a known goods category; every item id resolves in economy_goods.json (integrity-gated). Multipliers are permille (1500 = +50%). Price shocks decay to exactly neutral over decay_days after the weather clears; routes recover immediately.",
  "rules": [
    {
      "rule_id": "embargo_fallout_storm_medical",
      "weather_kind": "FalloutStorm",
      "affected_regions": ["*"],
      "affected_categories": ["medical"],
      "price_multiplier_permille": 1500,
      "caravan_blocked": true,
      "route_slow_permille": 1000,
      "decay_days": 2
    },
    {
      "rule_id": "embargo_black_rain_water",
      "weather_kind": "BlackRain",
      "affected_regions": ["flotilla"],
      "affected_categories": ["water"],
      "price_multiplier_permille": 1800,

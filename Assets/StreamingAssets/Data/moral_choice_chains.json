{
  "schema_version": 1,
  "description": "Branching architecture for the moral choice system. Defines 4 main branches (permanent path locks), merge-back rules, and quest accessibility gates. A quest is accessible only if all its prerequisites are met. Once a branch is 'locked_by' a resolution, the opposing branch's quests become permanently inaccessible.",
  "branches": [
    {
      "id": "branch_mercy_road",
      "display_name": "The Mercy Road",
      "description": "Compassion as a permanent stance. Helping becomes habit, then identity, then burden. Unlocks cooperative storylines; permanently closes the Iron Way and Broken Compact after the third mercy quest.",
      "lock_threshold": 3,
      "locks_out": ["branch_iron_way", "branch_broken_compact"],
      "merge_allowed": ["branch_listener_thread"],
      "entry_quests": ["quest_moral_chain_mercy_01", "quest_moral_chain_mercy_02", "quest_moral_chain_mercy_03"],
      "locked_flag": "flag_branch_mercy_road_locked"
    },
    {
      "id": "branch_iron_way",
      "display_name": "The Iron Way",
      "description": "Pragmatism hardens into ruthlessness. Survival at the cost of others becomes a doctrine. Permanently closes the Mercy Road and Listener's Thread after the third iron quest.",
      "lock_threshold": 3,
      "locks_out": ["branch_mercy_road", "branch_listener_thread"],
      "merge_allowed": ["branch_broken_compact"],
      "entry_quests": ["quest_moral_chain_iron_01", "quest_moral_chain_iron_02", "quest_moral_chain_iron_03"],
      "locked_flag": "flag_branch_iron_way_locked"
    },
    {
      "id": "branch_listener_thread",
      "display_name": "The Listener's Thread",
      "description": "Understanding over action. The player accumulates stories and wisdom instead of taking sides. Permanently closes the Iron Way and Broken Compact after the third listener quest.",
      "lock_threshold": 3,
      "locks_out": ["branch_iron_way", "branch_broken_compact"],
      "merge_allowed": ["branch_mercy_road"],
      "entry_quests": ["quest_moral_chain_listen_01", "quest_moral_chain_listen_02", "quest_moral_chain_listen_03"],
      "locked_flag": "flag_branch_listener_locked"
    },
    {
      "id": "branch_broken_compact",
      "display_name": "The Broken Compact",
      "description": "Betrayal as a survival strategy. Trust becomes a weapon. Permanently closes the Mercy Road and Listener's Thread after the third betrayal quest.",
      "lock_threshold": 3,
      "locks_out": ["branch_mercy_road", "branch_listener_thread"],
      "merge_allowed": ["branch_iron_way"],
      "entry_quests": ["quest_moral_chain_betray_01", "quest_moral_chain_betray_02", "quest_moral_chain_betray_03"],
      "locked_flag": "flag_branch_broken_compact_locked"
    }
  ],
  "merge_rules": {
    "description": "A player on Branch A can access merge quests from Branch B only if merge_allowed includes B. Merge quests are marked with 'merge_from' in their prerequisites. Merging does NOT unlock the merged branch's exclusive content — only the shared merge-point quests.",
    "merge_quest_prefix": "quest_moral_merge_",
    "merge_quests_require_min_progress": 5,
    "merge_never_unlocks_exclusive": true
  },
  "lockout_rules": {
    "description": "When a branch locks, all quests belonging to the locked-out branches become permanently inaccessible. The player can never return to those storylines. This creates meaningful permanent consequences.",
    "lockout_is_permanent": true,
    "lockout_fires_journal_entry": true,
    "lockout_journal_template": "A door has closed. The path of {locked_branch_name} is no longer open to you."
  },

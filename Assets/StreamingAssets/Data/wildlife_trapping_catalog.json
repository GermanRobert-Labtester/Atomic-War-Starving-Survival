      "checkIntervalDays": 2,
      "durabilityChecks": 15,
      "baseCatchModifier": 0.8,
      "compatiblePrey": ["rabbit", "rat", "fox", "rad_dog"],
      "requiresWater": false,
      "weatherSensitivity": 0.0
    },
    {
      "trap_id": "trap_bird_snare",
      "displayName": "Bird Snare",
      "description": "A fine noose of thread or thin wire set on a perch stick. Lightweight, fast to deploy, and fragile. Frequent small calories with a health-risk shadow. The birds that land on it are often the ones you should not eat.",
      "trapType": "bird_snare",
      "setupCosts": [
        { "itemId": "rope", "amount": 1 }
      ],
      "checkIntervalDays": 1,
      "durabilityChecks": 4,
      "baseCatchModifier": 0.7,
      "compatiblePrey": ["pheasant", "ash_crow", "contaminated_fowl"],
      "requiresWater": false,
      "weatherSensitivity": 0.3,
      "bycatchChance": 0.15,
      "bycatchSpecies": [
        { "speciesId": "irradiated_squirrel", "weight": 2.0 },
        { "speciesId": "rat", "weight": 1.0 }
      ]
    },
    {
      "trap_id": "trap_body_grip",
      "displayName": "Body-Grip Trap",
      "description": "A heavy spring-loaded mechanism that closes steel jaws on anything that passes through the frame. Efficient, durable, and severe. The misfire is as dangerous as the catch. Manufactured before the exchange, or found in trapper caches.",
      "trapType": "body_grip",
      "setupCosts": [
        { "itemId": "scrap_metal", "amount": 4 },
        { "itemId": "leather_strap", "amount": 1 }
      ],
      "checkIntervalDays": 2,
      "durabilityChecks": 15,
      "baseCatchModifier": 1.0,
      "compatiblePrey": ["muskrat", "fox", "cotton_hare"],
      "requiresWater": false,
      "weatherSensitivity": 0.0
    },
    {
      "trap_id": "trap_box",
      "displayName": "Box Trap",
      "description": "A wooden box with a gravity door, triggered by a treadle inside. Bulky, dependable, and shelter-craftable. The workhorse once the bunker can afford one. The animal is alive when you check it, which is the point.",
      "trapType": "box",
      "setupCosts": [
        { "itemId": "scrap_wood", "amount": 2 },
        { "itemId": "scrap_metal", "amount": 1 },
        { "itemId": "box_of_nails_10", "amount": 1 }
      ],
      "checkIntervalDays": 2,
      "durabilityChecks": 15,
      "baseCatchModifier": 0.8,
      "compatiblePrey": ["rabbit", "rat", "hedgehog", "irradiated_squirrel"],
      "requiresWater": false,
      "weatherSensitivity": 0.0
    },
    {
      "trap_id": "trap_improvised_wire",
      "displayName": "Improvised Wire Snare",
      "description": "A twist of copper wire shaped into a loose loop and pegged to the ground. The poorest survivor's option, better than doing nothing. It breaks often, catches little, and costs almost nothing to replace.",

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/DiegeticHud.uss" />
    <ui:VisualElement name="diegetic-root" class="diegetic-root" picking-mode="Ignore">
        <ui:VisualElement name="vitals-panel" class="diegetic-panel vitals-panel">
            <ui:Label name="vitals-clock" class="diegetic-title" text="DAY 1   00:00" />
            <ui:Label name="vitals-dose" class="diegetic-status" text="" />
            <ui:VisualElement name="vitals-needs" class="vitals-needs" />
            <ui:Label name="vitals-hint" class="diegetic-hint" text="[F1] eat  ·  [F2] drink  ·  [SPACE] pause  ·  [F5] save" />
        </ui:VisualElement>

        <ui:VisualElement name="event-panel" class="diegetic-panel event-panel hidden">
            <ui:Label name="event-title" class="diegetic-title" text="" />
            <ui:Label name="event-body" class="diegetic-body" text="" />
            <ui:VisualElement name="event-choices" class="event-choices" />
        </ui:VisualElement>

        <ui:VisualElement name="hatch-panel" class="diegetic-panel hatch-panel hidden">
            <ui:Label name="hatch-title" class="diegetic-title" text="HATCH DEFENSE" />
            <ui:Label name="hatch-status" class="diegetic-status" text="" />
            <ui:Label name="hatch-ammo" class="diegetic-body" text="" />
            <ui:Label name="hatch-arms" class="diegetic-body emphasis" text="" />
            <ui:Label name="hatch-hint" class="diegetic-hint" text="[H] close  ·  [B] workbench upgrades" />
        </ui:VisualElement>

        <ui:VisualElement name="encounter-panel" class="diegetic-panel encounter-panel">
            <ui:Label name="encounter-title" class="diegetic-title" text="FIELD CONTACT" />
            <ui:Label name="encounter-status" class="diegetic-status" text="ENCOUNTER LOG: quiet." />
            <ui:VisualElement name="encounter-list" class="encounter-list" />
            <ui:Label name="encounter-hint" class="diegetic-hint" text="Expedition combat feeds this strip." />
        </ui:VisualElement>

        <ui:VisualElement name="stores-panel" class="diegetic-panel stores-panel hidden">
            <ui:Label name="stores-title" class="diegetic-title" text="STORES FOCUS" />
            <ui:Label name="stores-summary" class="diegetic-status" text="" />
            <ui:Label name="stores-tooltip" class="diegetic-body" text="" />
            <ui:Label name="stores-hint" class="diegetic-hint" text="[I] next  ·  [Shift+I] prev  ·  [E] use" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

/* ===================================================================
   Phase 11 — Expansion UI Widget Stylesheet
   Shared styles for all 8 Phase 11 widgets.
   =================================================================== */

/* ── Radiation Phase Indicator ──────────────────────────────────── */
.radiation-phase-indicator {
    flex-direction: row;
    align-items: center;
    margin: 4px 8px;
}
.phase-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin-right: 6px;
}
.phase-dot.healthy { background-color: #4CAF50; }
.phase-dot.prodromal { background-color: #FFC107; animation: pulse 1s infinite; }
.phase-dot.latent { background-color: #4CAF50; }
.phase-dot.latent::after { content: "?"; color: #FFC107; font-size: 10px; }
.phase-dot.manifest { background-color: #F44336; animation: flash 0.5s infinite; }
.phase-dot.chronic { background-color: #9E9E9E; }
.phase-dot.recovery { background-color: #2196F3; }
.phase-tooltip { font-size: 11px; color: #9E9E9E; margin-left: 4px; }

/* ── Phantom Memory Vignette ────────────────────────────────────── */
.phantom-memory-vignette {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
}
.phantom-memory-vignette.active { opacity: 1; }
.vignette-gradient { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.vignette-gradient.motivation { background: radial-gradient(circle, transparent 40%, rgba(180,120,60,0.4) 100%); }
.vignette-gradient.breakdown { background: radial-gradient(circle, transparent 40%, rgba(60,80,120,0.5) 100%); }
.memory-text {
    position: absolute; bottom: 80px; left: 0; right: 0;
    text-align: center; font-size: 20px;
    -unity-font: url("project://database/Assets/_Game/UI/MainMenu/Fonts/BarlowCondensed-SemiBold_SDF.asset");
    color: #FFD54F;
}

/* ── Hypervigilance Indicator ───────────────────────────────────── */
.hypervigilance-indicator { position: absolute; top: 2px; right: 2px; width: 14px; height: 14px; }
.eye-icon { width: 14px; height: 14px; }
.eye-icon.low { background-color: #FFC107; border-radius: 7px; animation: pulse 2s infinite; }
.eye-icon.high { background-color: #F44336; border-radius: 7px; animation: pulse 0.8s infinite; }
@keyframes eye-shake {
    0%, 100% { transform: translate(0,0); }
    25% { transform: translate(-2px,0); }
    75% { transform: translate(2px,0); }
}
.eye-icon.false-alarm { animation: eye-shake 0.3s infinite; background-color: #F44336; }

/* ── Moral Branch Display ───────────────────────────────────────── */
.moral-branch-display { flex-direction: row; align-items: center; margin: 2px 4px; }
.branch-icon { width: 16px; height: 16px; margin-right: 4px; }
.branch-icon.numbed { background-color: #9E9E9E; }
.branch-icon.compassion { background-color: #42A5F5; }
.branch-label { font-size: 10px; color: #9E9E9E; -unity-font-style: italic; }

/* ── Keepsake Slot ──────────────────────────────────────────────── */
.keepsake-slot {
    width: 48px; height: 48px;
    border-width: 2px;
    border-color: #FFD54F;
    border-radius: 4px;
    margin: 4px;
    align-items: center;
    justify-content: center;
}
.keepsake-slot.lost { border-color: #F44336; opacity: 0.5; }
.slot-border { width: 44px; height: 44px; }
.item-icon { width: 40px; height: 40px; }
.cracked-overlay {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0;
    transition: opacity 0.3s;
}
.cracked-overlay.visible { opacity: 0.7; }
.grief-vignette {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(244, 67, 54, 0.3);
}

/* ── Memorial Wall ──────────────────────────────────────────────── */
.memorial-wall {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(28, 28, 28, 0.97);
    flex-direction: column;
    padding: 24px;
}
.wall-background { position: absolute; top: 0; left: 0; right: 0; bottom: 0; opacity: 0.15; }
.entries-scroll { flex-grow: 1; margin: 12px 0; }
.memorial-entry { flex-direction: row; align-items: center; padding: 8px 0;
    border-bottom-width: 1px; border-bottom-color: rgba(189,189,189,0.2); }
.memorial-entry .name { font-size: 16px; color: #BDBDBD; margin-right: 12px; }
.memorial-entry .detail { font-size: 12px; color: #757575; }
.pay-respects-button {
    background-color: rgba(255,193,7,0.2);
    border-width: 1px; border-color: #FFC107;
    border-radius: 4px; padding: 8px 24px;
    font-size: 14px; color: #FFC107;
    align-self: flex-end;
}
.pay-respects-button:hover { background-color: rgba(255,193,7,0.4); }
.empty-state { font-size: 16px; color: #757575; -unity-font-style: italic; text-align: center; margin-top: 40px; }

/* ── Terminal Prognosis Banner ──────────────────────────────────── */
.terminal-prognosis-banner {
    height: 24px; flex-direction: row; align-items: center;
    padding: 0 8px; margin: 2px 0; border-radius: 2px;
}
.terminal-prognosis-banner.active { background-color: rgba(255,193,7,0.15); border-width: 1px; border-color: #FFC107; }
.terminal-prognosis-banner.completed { background-color: rgba(255,213,79,0.15); border-width: 1px; border-color: #FFD54F; }
.terminal-prognosis-banner.failed { background-color: rgba(158,158,158,0.15); border-width: 1px; border-color: #9E9E9E; }
.prognosis-text { font-size: 11px; color: #FFC107; }

/* ── Addiction Detox Indicator ──────────────────────────────────── */
.addiction-detox-indicator { width: 16px; height: 16px; border-radius: 8px; margin: 2px; }
.addiction-detox-indicator.dependent { background-color: #FF9800; }
.addiction-detox-indicator.withdrawal { background-color: #F44336; animation: pulse 0.5s infinite; }
.addiction-detox-indicator.managed-detox { background-color: #FFC107; animation: pulse 2s infinite; }
.addiction-detox-indicator.recovered { background-color: #4CAF50; transition: opacity 1s; }
.addiction-detox-indicator.recovered.fading { opacity: 0; }

/* ── Shared Animations ──────────────────────────────────────────── */
@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}
@keyframes flash {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}

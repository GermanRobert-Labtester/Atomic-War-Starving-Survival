<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/DiegeticHud.uss" />
    <Style src="project://database/Assets/_Game/UI/UIBatch20_A.uss" />
    <ui:VisualElement name="fallout-storm-root" class="fallout-storm-banner hidden" picking-mode="Ignore">
        <ui:VisualElement class="fallout-storm-info">
            <ui:VisualElement class="fallout-storm-title-row">
                <ui:Label name="storm-name" class="fallout-storm-name" text="FALLOUT STORM INBOUND" />
                <ui:Label name="intensity-badge" class="fallout-intensity-badge" text="BLACK RAIN" />
            </ui:VisualElement>
            <ui:Label name="wind-direction" class="fallout-storm-wind" text="WIND: ↖ NW @ 45 KM/H" />
        </ui:VisualElement>

        <ui:VisualElement class="fallout-timer-container">
            <ui:Label name="timer-val" class="fallout-timer-val" text="00:30" />
            <ui:VisualElement class="fallout-timer-track">
                <ui:VisualElement name="timer-fill" class="fallout-timer-fill" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Button name="dismiss-button" class="fallout-dismiss-btn" text="DISMISS" />
    </ui:VisualElement>
</ui:UXML>

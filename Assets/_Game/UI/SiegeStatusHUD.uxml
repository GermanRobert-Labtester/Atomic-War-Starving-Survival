<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/Phase11Widgets.uss" />
    <ui:VisualElement name="siege-status" class="siege-status hidden" picking-mode="Position">
        <ui:Label name="siege-label" class="siege-label" text="SIEGE ACTIVE" />
        <ui:Label class="siege-bar-label" text="HATCH INTEGRITY" />
        <ui:ProgressBar name="hatch-integrity-bar" class="hatch-integrity-bar" low-value="0" high-value="100" value="100" />
        <ui:Label class="siege-bar-label" text="BREACH PROGRESS" />
        <ui:ProgressBar name="breach-progress-bar" class="breach-progress-bar" low-value="0" high-value="100" value="0" />
        <ui:VisualElement name="reinforcement-icon" class="reinforcement-icon" />
        <ui:VisualElement name="active-effects" class="active-effects" />
        <ui:VisualElement name="command-buttons" class="command-buttons" />
    </ui:VisualElement>
</ui:UXML>

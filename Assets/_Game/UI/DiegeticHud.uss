/*
 * Diegetic in-game HUD — hatch ammo / arms, encounter log, stores tooltip.
 *
 * Tokens match MainMenu.uss (ported from the Figma Make prototype): ink / line /
 * warm / hot / pale / muted / dim + Barlow Condensed + ShareTech Mono.
 * Absolute corner panels so they never fight full-screen menus.
 */

:root {
    --ink: #090b0c;
    --ink-panel: rgba(9, 11, 12, 0.86);
    --line: rgba(217, 196, 152, 0.27);
    --line-soft: rgba(217, 196, 152, 0.14);
    --warm: #d3aa62;
    --hot: #f4c875;
    --pale: #e6e0d2;
    --muted: #938f84;
    --dim: #66675f;
    /* Military exclusive — copper rust, not bright red (restrained tone). */
    --exclusive: #c4785a;
    --exclusive-line: rgba(196, 120, 90, 0.45);

    --font-body: url("project://database/Assets/_Game/UI/MainMenu/Fonts/BarlowCondensed-Regular_SDF.asset");
    --font-semibold: url("project://database/Assets/_Game/UI/MainMenu/Fonts/BarlowCondensed-SemiBold_SDF.asset");
    --font-bold: url("project://database/Assets/_Game/UI/MainMenu/Fonts/BarlowCondensed-Bold_SDF.asset");
    --font-mono: url("project://database/Assets/_Game/UI/MainMenu/Fonts/ShareTechMono-Regular_SDF.asset");
}

.diegetic-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    picking-mode: ignore;
    color: var(--pale);
    -unity-font-definition: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.5px;
}

.diegetic-panel {
    position: absolute;
    background-color: var(--ink-panel);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--line);
    border-right-color: var(--line-soft);
    border-top-color: var(--line-soft);
    border-bottom-color: var(--line-soft);
    /* Warm accent bar on the leading edge — same language as menu rows. */
    border-left-width: 2px;
    border-left-color: var(--warm);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    max-width: 420px;
    picking-mode: position;
}

.diegetic-panel.hidden {
    display: none;
}

/* Hatch block — top-right when [H] open */
.hatch-panel {
    top: 16px;
    right: 16px;
    min-width: 300px;
    max-height: 440px;
}

/* Encounter log strip — bottom-left */
.encounter-panel {
    bottom: 16px;
    left: 16px;
    min-width: 340px;
    max-width: 500px;
    max-height: 220px;
    /* Slightly cooler leading edge so it reads as field radio, not hatch. */
    border-left-color: var(--muted);
}

/* Stores focus tooltip — bottom-right when inventory strip has keyboard focus */
.stores-panel {
    bottom: 16px;
    right: 16px;
    min-width: 280px;
    max-width: 380px;
}

.stores-panel.exclusive-panel {
    border-left-color: var(--exclusive);
}

.diegetic-title {
    -unity-font-definition: var(--font-semibold);
    color: var(--warm);
    font-size: 12px;
    letter-spacing: 1.8px;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.diegetic-status {
    -unity-font-definition: var(--font-mono);
    color: var(--pale);
    font-size: 11px;
    letter-spacing: 0.6px;
    white-space: normal;
    margin-bottom: 6px;
}

.diegetic-body {
    -unity-font-definition: var(--font-mono);
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.4px;
    white-space: normal;
    margin-bottom: 4px;
}

.diegetic-body.emphasis {
    color: var(--hot);
}

.diegetic-body.exclusive {
    color: var(--exclusive);
}

.diegetic-line {
    -unity-font-definition: var(--font-mono);
    color: var(--muted);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 3px;
    padding-left: 6px;
    border-left-width: 1px;
    border-left-color: var(--line-soft);
}

.diegetic-hint {
    -unity-font-definition: var(--font-mono);
    color: var(--dim);
    font-size: 10px;
    letter-spacing: 0.5px;
    margin-top: 8px;
}

.encounter-list {
    flex-direction: column;
    max-height: 148px;
}

/* Vitals: the core-loop readout. Always visible, unlike the other panels. */
/* Vitals — bottom-centre. Had no positioning at all, so it defaulted to the
   absolute origin and rendered on top of the event prompt and the workbench.
   The persistent core readout, so it gets the free bottom edge between the
   encounter log (bottom-left) and the stores tooltip (bottom-right). */
.vitals-panel {
    bottom: 16px;
    left: 50%;
    translate: -50% 0;
    min-width: 320px;
}

.vitals-needs {
    flex-direction: column;
    margin-top: 4px;
}

.vitals-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.vitals-row__label {
    width: 84px;
    -unity-font-style: bold;
}

.vitals-row__track {
    flex-grow: 1;
    height: 8px;
    background-color: rgba(255, 255, 255, 0.08);
}

.vitals-row__fill {
    height: 8px;
    background-color: rgb(51, 204, 77);
}

.vitals-row__fill.critical {
    background-color: rgb(230, 51, 51);
}

.vitals-row__value {
    width: 48px;
    -unity-text-align: middle-right;
}

/* Event prompt: hidden until EventRunner fires, keys 1/2/3 pick a row.
   Screen centre. It previously had no positioning at all and stacked at the
   absolute origin on top of vitals and the workbench. It is the most
   attention-demanding transient panel, so it takes the middle. It shares that
   space with the endgame summary, which is added later in the tree and so
   draws on top -- deliberate: once the campaign is over the prompt underneath
   no longer matters.

   The width/max-height pair below is load-bearing and was arrived at by
   measuring resolved worldBound against a live panel, not by reasoning. In a
   1440x1080 layout space, true centre is x=720:

     min-width:420 + max-width:560 -> resolved 420.8 wide, centre 667.2  (bad)
     width:520 + max-height:480    -> resolved 420.8 wide, centre 720.0  (good)
     no constraints at all         -> resolved 312.8 wide, centre 685.1  (bad)

   Note the resolved width is 420.8 whether width is 520 or the min/max pair,
   so `width` is not doing what it looks like it does here -- it changes the
   resolved transform without changing the resolved width. Unexplained, but
   reproducible. Do not "simplify" these two declarations away without
   re-measuring; dropping them shrinks the panel and pulls it off centre.

   Separately, this panel renders ~26px below true vertical centre in every
   configuration tried, including with no constraints at all. Small enough to
   leave (2.4% of height) and not caused by max-height, contrary to first
   appearances.

   If a long choice list ever grows this panel tall enough to reach the vitals
   readout at y=801, bound the inner .event-choices list, not the panel. */
.event-panel {
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 520px;
    max-height: 480px;
}

.event-choices {
    flex-direction: column;
    margin-top: 6px;
}

.event-choice {
    margin-bottom: 3px;
    white-space: normal;
}

.event-choice--disabled {
    opacity: 0.45;
}

/* Workbench readout — top-left when [B] open. WorkbenchUI already formats its
   own header/notes/numbered lines, so this panel is a single terminal block. */
.workbench-panel {
    top: 16px;
    left: 16px;
    min-width: 340px;
    max-width: 480px;
    max-height: 440px;
}

.workbench-readout {
    white-space: normal;
    margin-bottom: 0;
}

/* Endgame summary — screen centre. Every other panel is corner-anchored; this
   one is terminal and exclusive, so it takes the middle rather than competing
   for a corner. Centred by offsetting half its own size, which is why the
   translate is a percentage and not a fixed length. */
.endgame-panel {
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    min-width: 480px;
    max-width: 680px;
}

.endgame-readout {
    white-space: normal;
    margin-bottom: 0;
}

/* Power budget — top-centre. The four corners are taken (hatch, encounter,
   stores, workbench) and the centre belongs to the endgame summary, so this
   toggled panel takes the remaining free edge. Only the horizontal axis is
   offset by half its own width; the top stays pinned. */
.power-grid-panel {
    top: 16px;
    left: 50%;
    translate: -50% 0;
    min-width: 340px;
    max-width: 520px;
}

.power-grid-readout {
    white-space: normal;
    margin-bottom: 0;
}

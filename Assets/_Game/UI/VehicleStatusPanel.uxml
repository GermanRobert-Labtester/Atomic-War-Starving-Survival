<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/Phase11Widgets.uss" />
    <ui:VisualElement name="vehicle-status-panel" class="vehicle-status-panel hidden" picking-mode="Position">
        <ui:Label name="vehicle-name" class="vehicle-name" text="VEHICLE" />
        <ui:Label class="vehicle-bar-label" text="CONDITION" />
        <ui:ProgressBar name="condition-bar" class="vehicle-condition-bar" low-value="0" high-value="100" value="100" />
        <ui:Label class="vehicle-bar-label" text="FUEL" />
        <ui:ProgressBar name="fuel-bar" class="vehicle-fuel-bar" low-value="0" high-value="100" value="0" />
        <ui:Label name="fuel-value" class="fuel-value" text="0 / 0 L" />
        <ui:Label class="vehicle-bar-label" text="CARGO" />
        <ui:ProgressBar name="cargo-bar" class="vehicle-cargo-bar" low-value="0" high-value="100" value="0" />
        <ui:Label name="cargo-value" class="cargo-value" text="0 / 0 kg" />
        <ui:VisualElement name="mod-slots" class="mod-slots" />
        <ui:Label name="breakdown-risk" class="breakdown-risk" text="" />
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/DiegeticHud.uss" />
    <Style src="project://database/Assets/_Game/UI/UIBatch20_A.uss" />
    <ui:VisualElement name="ration-dial-root" class="ration-dial-modal hidden" picking-mode="Position">
        <ui:VisualElement class="dosimeter-header">
            <ui:Label name="ration-modal-title" class="ashfall-title" text="RATION ALLOCATION DIAL" />
            <ui:Label class="ashfall-mono" text="DAILY tithe" />
        </ui:VisualElement>

        <ui:Label name="survivor-name-label" class="ration-survivor-hdr" text="RECIPIENT: SGT. VANCE" />

        <ui:VisualElement class="ration-slots-container">
            <ui:VisualElement name="slot-0" class="ration-slot-card selected-slot">
                <ui:Label name="slot-0-name" class="ration-slot-name" text="CANNED MEAT" />
                <ui:Label name="slot-0-cals" class="ration-slot-cals" text="400 KCAL" />
            </ui:VisualElement>

            <ui:VisualElement name="slot-1" class="ration-slot-card">
                <ui:Label name="slot-1-name" class="ration-slot-name" text="DRY BISCUITS" />
                <ui:Label name="slot-1-cals" class="ration-slot-cals" text="250 KCAL" />
            </ui:VisualElement>

            <ui:VisualElement name="slot-2" class="ration-slot-card">
                <ui:Label name="slot-2-name" class="ration-slot-name" text="SYNTH-PASTE" />
                <ui:Label name="slot-2-cals" class="ration-slot-cals" text="150 KCAL" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="ration-controls-row">
            <ui:Button name="btn-decrement" class="ration-btn-adjust" text="-" />
            <ui:Label name="calorie-count-label" class="ration-cals-total" text="400 KCAL" />
            <ui:Button name="btn-increment" class="ration-btn-adjust" text="+" />
        </ui:VisualElement>

        <ui:VisualElement class="ration-action-row">
            <ui:Button name="btn-skip" class="ration-btn-skip" text="SKIP RATION" />
            <ui:Button name="btn-confirm" class="ration-btn-confirm" text="CONFIRM" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

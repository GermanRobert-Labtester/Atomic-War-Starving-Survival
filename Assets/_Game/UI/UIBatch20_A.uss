/*
 * UIBatch20_A.uss — ASHFALL 2D Atomic-War Survival UI Toolkit Stylesheet
 * Custom styles for Batch 20 Elements 01-10.
 *
 * Mandatory Tokens:
 * --ink: #090b0c           --ink-panel: rgba(9,11,12,0.86)
 * --warm: #d3aa62          --hot: #f4c875
 * --pale: #e6e0d2          --muted: #938f84           --dim: #66675f
 * --critical: #e63333      --exclusive: #c4785a
 * --entropy: #c97b3a       --lethe: #6ea3a8
 */

:root {
    --ink: #090b0c;
    --ink-panel: rgba(9, 11, 12, 0.86);
    --line: rgba(217, 196, 152, 0.27);
    --line-soft: rgba(217, 196, 152, 0.14);
    --warm: #d3aa62;
    --hot: #f4c875;
    --pale: #e6e0d2;
    --muted: #938f84;
    --dim: #66675f;
    --exclusive: #c4785a;
    --critical: #e63333;
    --entropy: #c97b3a;
    --lethe: #6ea3a8;

    --font-body: url("project://database/Assets/_Game/UI/MainMenu/Fonts/BarlowCondensed-Regular_SDF.asset");
    --font-semibold: url("project://database/Assets/_Game/UI/MainMenu/Fonts/BarlowCondensed-SemiBold_SDF.asset");
    --font-mono: url("project://database/Assets/_Game/UI/MainMenu/Fonts/ShareTechMono-Regular_SDF.asset");
}

/* Global Hidden class */
.hidden {
    display: none;
}

/* Common Base Panel */
.ashfall-panel {
    background-color: var(--ink-panel);
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 3px;
    border-left-color: var(--warm);
    padding: 12px;
    color: var(--pale);
    -unity-font-definition: var(--font-body);
    font-size: 13px;
}

.ashfall-title {
    -unity-font-definition: var(--font-semibold);
    font-size: 14px;
    color: var(--warm);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 6px;
}

.ashfall-mono {
    -unity-font-definition: var(--font-mono);
}

/* ==========================================
   01. RadiationDosimeterWidget
   ========================================== */
.radiation-dosimeter-panel {
    position: absolute;
    left: 20px;
    top: 120px;
    width: 260px;
    background-color: var(--ink-panel);
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 3px;
    border-left-color: var(--lethe);
    padding: 12px;
}

.radiation-dosimeter-panel.critical-state {
    border-left-color: var(--critical);
}

.dosimeter-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-soft);
    padding-bottom: 4px;
    margin-bottom: 8px;
}

.dosimeter-main-dose {
    align-items: center;
    margin-vertical: 8px;
}

.dosimeter-dose-val {
    -unity-font-definition: var(--font-mono);
    font-size: 24px;
    color: var(--hot);
    -unity-font-style: bold;
}

.dosimeter-rate-val {
    -unity-font-definition: var(--font-mono);
    font-size: 13px;
    color: var(--pale);
    margin-top: 2px;
}

.dosimeter-arc-track {
    height: 12px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: var(--line-soft);
    border-radius: 2px;
    margin-vertical: 8px;
    overflow: hidden;
}

.dosimeter-arc-fill {
    height: 100%;
    width: 0%;
    background-color: var(--lethe);
}

.dosimeter-arc-fill.critical-fill {
    background-color: var(--critical);
}

.dosimeter-critical-badge {
    background-color: var(--critical);
    color: #ffffff;
    -unity-font-definition: var(--font-semibold);
    font-size: 11px;
    padding-horizontal: 6px;
    padding-vertical: 2px;
    border-radius: 2px;
    align-self: center;
    margin-top: 4px;
}

/* ==========================================
   02. GeigerSweepGauge
   ========================================== */
.geiger-sweep-panel {
    position: absolute;
    left: 20px;
    top: 320px;
    width: 260px;
    background-color: var(--ink-panel);
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 3px;
    border-left-color: var(--warm);
    padding: 10px;
}

.geiger-counter-readout {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(0,0,0,0.5);
    padding: 6px 10px;
    border-width: 1px;
    border-color: var(--line-soft);
    margin-vertical: 6px;
}

.geiger-cpm-label {
    -unity-font-definition: var(--font-mono);
    font-size: 18px;
    color: var(--warm);
}

.geiger-needle-container {
    height: 16px;
    background-color: #050607;
    border-width: 1px;
    border-color: var(--line-soft);
    margin-vertical: 6px;
    position: relative;
    overflow: hidden;
}

.geiger-needle-indicator {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    left: 0%;
    background-color: var(--hot);
    border-right-width: 1px;
    border-right-color: var(--ink);
}

.geiger-status-strip {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
}

.geiger-status-pill {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 10px;
    -unity-font-definition: var(--font-semibold);
    color: var(--dim);
    padding-vertical: 3px;
    border-width: 1px;
    border-color: var(--line-soft);
    margin-horizontal: 2px;
    background-color: rgba(0, 0, 0, 0.4);
}

.geiger-status-pill.active-clear {
    color: var(--lethe);
    border-color: var(--lethe);
    background-color: rgba(110, 163, 168, 0.2);
}

.geiger-status-pill.active-elevated {
    color: var(--warm);
    border-color: var(--warm);
    background-color: rgba(211, 170, 98, 0.2);
}

.geiger-status-pill.active-alert {
    color: var(--critical);
    border-color: var(--critical);
    background-color: rgba(230, 51, 51, 0.25);
}

/* ==========================================
   03. AirFilterIntegrityBar
   ========================================== */
.air-filter-panel {
    position: absolute;
    top: 20px;
    left: 300px;
    width: 400px;
    background-color: var(--ink-panel);
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 3px;
    border-left-color: var(--lethe);
    padding: 10px 14px;
}

.air-filter-panel.warning-state {
    border-left-color: var(--warm);
}

.air-filter-panel.critical-state {
    border-left-color: var(--critical);
}

.air-filter-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.air-filter-bar-track {
    height: 14px;
    background-color: rgba(0,0,0,0.6);
    border-width: 1px;
    border-color: var(--line-soft);
    margin-vertical: 6px;
    overflow: hidden;
}

.air-filter-bar-fill {
    height: 100%;
    width: 80%;
    background-color: var(--lethe);
}

.air-filter-bar-fill.fill-amber {
    background-color: var(--warm);
}

.air-filter-bar-fill.fill-red {
    background-color: var(--critical);
}

.air-filter-meta-row {
    flex-direction: row;
    justify-content: space-between;
    font-size: 11px;
    color: var(--muted);
}

/* ==========================================
   04. FalloutStormWarningBanner
   ========================================== */
.fallout-storm-banner {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background-color: rgba(9, 11, 12, 0.95);
    border-bottom-width: 2px;
    border-bottom-color: var(--critical);
    padding: 12px 24px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.fallout-storm-info {
    flex-direction: column;
}

.fallout-storm-title-row {
    flex-direction: row;
    align-items: center;
}

.fallout-storm-name {
    -unity-font-definition: var(--font-semibold);
    font-size: 16px;
    color: var(--critical);
    letter-spacing: 1.5px;
    margin-right: 12px;
}

.fallout-intensity-badge {
    background-color: var(--critical);
    color: #ffffff;
    font-size: 10px;
    -unity-font-definition: var(--font-semibold);
    padding: 2px 6px;
    border-radius: 2px;
}

.fallout-storm-wind {
    -unity-font-definition: var(--font-mono);
    font-size: 12px;
    color: var(--pale);
    margin-top: 4px;
}

.fallout-timer-container {
    width: 220px;
    align-items: flex-end;
}

.fallout-timer-val {
    -unity-font-definition: var(--font-mono);
    font-size: 14px;
    color: var(--hot);
    margin-bottom: 4px;
}

.fallout-timer-track {
    width: 100%;
    height: 6px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: var(--line-soft);
    overflow: hidden;
}

.fallout-timer-fill {
    height: 100%;
    width: 100%;
    background-color: var(--critical);
}

.fallout-dismiss-btn {
    background-color: rgba(230, 51, 51, 0.2);
    border-width: 1px;
    border-color: var(--critical);
    color: var(--pale);
    padding: 4px 10px;
    font-size: 11px;
    -unity-font-definition: var(--font-semibold);
    margin-left: 16px;
}

.fallout-dismiss-btn:hover {
    background-color: var(--critical);
    color: #ffffff;
}

/* ==========================================
   05. SurvivorPortraitCard
   ========================================== */
.survivor-portrait-card {
    width: 180px;
    height: 240px;
    background-color: var(--ink-panel);
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 3px;
    border-left-color: var(--warm);
    padding: 8px;
    justify-content: space-between;
}

.survivor-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-soft);
    padding-bottom: 4px;
}

.survivor-name-text {
    -unity-font-definition: var(--font-semibold);
    font-size: 13px;
    color: var(--pale);
}

.survivor-role-tag {
    -unity-font-definition: var(--font-mono);
    font-size: 9px;
    color: var(--warm);
    background-color: rgba(211, 170, 98, 0.15);
    padding: 1px 4px;
    border-width: 1px;
    border-color: var(--line-soft);
}

.survivor-blood-badge {
    -unity-font-definition: var(--font-mono);
    font-size: 10px;
    color: var(--exclusive);
    background-color: rgba(196, 120, 90, 0.2);
    padding: 1px 5px;
    border-radius: 2px;
    align-self: flex-end;
}

.survivor-stats-container {
    margin-vertical: 4px;
}

.survivor-stat-row {
    flex-direction: row;
    align-items: center;
    margin-vertical: 2px;
}

.survivor-stat-label {
    width: 42px;
    font-size: 9px;
    color: var(--muted);
    -unity-font-definition: var(--font-semibold);
}

.survivor-stat-track {
    flex-grow: 1;
    height: 6px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: var(--line-soft);
    overflow: hidden;
    margin-horizontal: 4px;
}

.survivor-stat-fill {
    height: 100%;
    width: 50%;
    background-color: var(--warm);
}

.survivor-stat-fill.fill-rad {
    background-color: var(--critical);
}

.survivor-stat-val {
    width: 26px;
    -unity-font-definition: var(--font-mono);
    font-size: 9px;
    color: var(--pale);
    -unity-text-align: middle-right;
}

.survivor-status-label {
    -unity-font-definition: var(--font-semibold);
    font-size: 10px;
    -unity-text-align: middle-center;
    padding-vertical: 2px;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 1px;
    border-color: var(--line-soft);
    color: var(--pale);
}

.survivor-status-label.status-critical {
    color: var(--critical);
    border-color: var(--critical);
    background-color: rgba(230, 51, 51, 0.2);
}

/* ==========================================
   06. MoralDecayMeter
   ========================================== */
.moral-decay-panel {
    position: absolute;
    left: 20px;
    top: 480px;
    width: 160px;
    background-color: var(--ink-panel);
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 3px;
    border-left-color: var(--entropy);
    padding: 10px;
}

.moral-decay-pip-stack {
    flex-direction: column-reverse;
    height: 140px;
    margin-vertical: 8px;
    justify-content: space-between;
}

.moral-decay-pip {
    height: 10px;
    background-color: rgba(211, 170, 98, 0.2);
    border-width: 1px;
    border-color: var(--line-soft);
    margin-vertical: 1px;
}

.moral-decay-pip.active-pip {
    background-color: var(--warm);
}

.moral-decay-pip.critical-pip {
    background-color: rgba(230, 51, 51, 0.2);
    border-color: rgba(230, 51, 51, 0.4);
}

.moral-decay-pip.active-pip.critical-pip {
    background-color: var(--critical);
    border-color: var(--critical);
}

.moral-breaking-label {
    -unity-font-definition: var(--font-semibold);
    font-size: 11px;
    color: var(--critical);
    -unity-text-align: middle-center;
    background-color: rgba(230, 51, 51, 0.2);
    border-width: 1px;
    border-color: var(--critical);
    padding: 3px;
    margin-top: 4px;
}

/* ==========================================
   07. RationAllocationDial
   ========================================== */
.ration-dial-modal {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 440px;
    margin-left: -220px;
    margin-top: -160px;
    background-color: var(--ink-panel);
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 3px;
    border-left-color: var(--warm);
    padding: 16px;
}

.ration-survivor-hdr {
    -unity-font-definition: var(--font-mono);
    font-size: 14px;
    color: var(--hot);
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-soft);
    padding-bottom: 4px;
}

.ration-slots-container {
    flex-direction: row;
    justify-content: space-between;
    margin-vertical: 10px;
}

.ration-slot-card {
    flex-grow: 1;
    width: 120px;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 1px;
    border-color: var(--line-soft);
    padding: 8px;
    margin-horizontal: 4px;
    align-items: center;
}

.ration-slot-card.selected-slot {
    border-color: var(--warm);
    background-color: rgba(211, 170, 98, 0.15);
}

.ration-slot-name {
    -unity-font-definition: var(--font-semibold);
    font-size: 12px;
    color: var(--pale);
    margin-bottom: 4px;
}

.ration-slot-cals {
    -unity-font-definition: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
}

.ration-controls-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-vertical: 12px;
    background-color: rgba(0,0,0,0.5);
    padding: 8px;
    border-width: 1px;
    border-color: var(--line-soft);
}

.ration-btn-adjust {
    width: 36px;
    height: 30px;
    background-color: rgba(211, 170, 98, 0.2);
    border-width: 1px;
    border-color: var(--warm);
    color: var(--pale);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.ration-btn-adjust:hover {
    background-color: var(--warm);
    color: var(--ink);
}

.ration-cals-total {
    -unity-font-definition: var(--font-mono);
    font-size: 16px;
    color: var(--hot);
}

.ration-action-row {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: 10px;
}

.ration-btn-skip {
    color: var(--muted);
    font-size: 12px;
    margin-right: 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--muted);
}

.ration-btn-skip:hover {
    color: var(--pale);
}

.ration-btn-confirm {
    background-color: var(--warm);
    color: var(--ink);
    -unity-font-definition: var(--font-semibold);
    font-size: 13px;
    padding: 6px 18px;
    border-width: 0;
}

.ration-btn-confirm:hover {
    background-color: var(--hot);
}

/* ==========================================
   08. WaterPurityGauge
   ========================================== */
.water-purity-panel {
    position: absolute;
    right: 20px;
    top: 120px;
    width: 250px;
    background-color: var(--ink-panel);
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 3px;
    border-left-color: var(--lethe);
    padding: 12px;
}

.water-stat-group {
    margin-vertical: 4px;
    flex-direction: row;
    justify-content: space-between;
}

.water-stat-lbl {
    font-size: 11px;
    color: var(--muted);
}

.water-stat-val {
    -unity-font-definition: var(--font-mono);
    font-size: 12px;
    color: var(--lethe);
}

.water-stat-val.critical-val {
    color: var(--critical);
}

.water-contam-bar-track {
    height: 10px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: var(--line-soft);
    margin-vertical: 6px;
    overflow: hidden;
}

.water-contam-bar-fill {
    height: 100%;
    width: 10%;
    background-color: var(--lethe);
}

.water-contam-bar-fill.critical-contam {
    background-color: var(--critical);
}

/* ==========================================
   09. TemperatureReadoutWidget
   ========================================== */
.temperature-readout-panel {
    position: absolute;
    right: 20px;
    top: 20px;
    width: 250px;
    background-color: var(--ink-panel);
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 3px;
    border-left-color: var(--warm);
    padding: 10px 12px;
}

.temp-readings-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-vertical: 6px;
    background-color: rgba(0, 0, 0, 0.4);
    padding: 6px;
    border-width: 1px;
    border-color: var(--line-soft);
}

.temp-val-box {
    align-items: center;
}

.temp-val-num {
    -unity-font-definition: var(--font-mono);
    font-size: 16px;
    color: var(--hot);
}

.temp-status-badge {
    -unity-font-definition: var(--font-semibold);
    font-size: 11px;
    color: var(--warm);
    -unity-text-align: middle-center;
    padding-vertical: 2px;
    margin-vertical: 4px;
}

.temp-status-badge.status-freezing {
    color: var(--lethe);
}

.temp-status-badge.status-critical {
    color: var(--critical);
    background-color: rgba(230, 51, 51, 0.2);
    border-width: 1px;
    border-color: var(--critical);
}

.temp-fuel-row {
    flex-direction: row;
    justify-content: space-between;
    font-size: 11px;
    color: var(--muted);
    margin-top: 4px;
}

/* ==========================================
   10. PowerFlowSchematic
   ========================================== */
.power-flow-modal {
    position: absolute;
    top: 40px;
    left: 50%;
    width: 540px;
    margin-left: -270px;
    background-color: var(--ink-panel);
    border-width: 1px;
    border-color: var(--line);
    border-left-width: 3px;
    border-left-color: var(--warm);
    padding: 16px;
}

.power-flow-modal.blackout-state {
    border-left-color: var(--critical);
}

.power-grid-8 {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-vertical: 12px;
}

.power-node-box {
    width: 24%;
    height: 52px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: var(--line-soft);
    padding: 4px 6px;
    margin-bottom: 8px;
    justify-content: space-between;
}

.power-node-box.node-active {
    border-color: var(--warm);
    background-color: rgba(211, 170, 98, 0.15);
}

.power-node-box.node-overloaded {
    border-color: var(--critical);
    background-color: rgba(230, 51, 51, 0.2);
}

.power-node-name {
    font-size: 10px;
    -unity-font-definition: var(--font-semibold);
    color: var(--pale);
}

.power-node-load {
    -unity-font-definition: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
}

.power-budget-bar-track {
    height: 14px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: var(--line-soft);
    margin-vertical: 6px;
    overflow: hidden;
}

.power-budget-bar-fill {
    height: 100%;
    width: 50%;
    background-color: var(--warm);
}

.power-budget-bar-fill.overload-fill {
    background-color: var(--critical);
}

.power-blackout-banner {
    background-color: var(--critical);
    color: #ffffff;
    -unity-font-definition: var(--font-semibold);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    padding-vertical: 4px;
    margin-top: 8px;
}

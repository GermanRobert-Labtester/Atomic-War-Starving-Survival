<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/DiegeticHud.uss" />
    <Style src="project://database/Assets/_Game/UI/UIBatch20_A.uss" />
    <ui:VisualElement name="air-filter-root" class="air-filter-panel hidden" picking-mode="Ignore">
        <ui:VisualElement class="air-filter-row">
            <ui:Label name="air-filter-title" class="ashfall-title" text="AIR FILTER INTEGRITY" />
            <ui:Label name="integrity-val" class="ashfall-mono" text="100%" />
        </ui:VisualElement>

        <ui:VisualElement name="bar-track" class="air-filter-bar-track">
            <ui:VisualElement name="bar-fill" class="air-filter-bar-fill" />
        </ui:VisualElement>

        <ui:VisualElement class="air-filter-meta-row">
            <ui:Label name="countdown-val" class="ashfall-mono" text="REPLACEMENT DUE: 14 DAYS" />
            <ui:Label name="toxicity-val" class="ashfall-mono" text="TOXICITY: 0 PPM (SAFE)" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

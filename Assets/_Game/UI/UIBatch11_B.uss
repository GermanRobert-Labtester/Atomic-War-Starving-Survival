/*
 * UIBatch11_B.uss — Phase 11 Expansion HUD widgets 5-8
 */
:root {
    --keepsake-gold: #d3aa62;
    --terminal-amber: #f4c875;
    --terminal-golden: #d3aa62;
    --terminal-failed: #66675f;
    --addiction-orange: #c97b3a;
    --addiction-withdrawal: #e63333;
    --addiction-detox: #FFC107;
    --addiction-recovered: #4CAF50;
}

/* 5 Keepsake Slot */
.keepsake-slot {
    width: 48px;
    height: 48px;
    border-width: 2px;
    border-color: var(--keepsake-gold);
    background-color: rgba(9, 11, 12, 0.86);
    margin-top: 8px;
    justify-content: center;
    align-items: center;
}
.keepsake-slot-icon {
    font-size: 10px;
    color: var(--pale, #e6e0d2);
    -unity-text-align: middle-center;
}
.keepsake-slot--lost {
    opacity: 0.45;
}
.keepsake-crack-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(230, 51, 51, 0.15);
    opacity: 0;
}
.keepsake-crack-overlay--visible {
    opacity: 1;
}

/* 6 Memorial Wall */
.memorial-wall {
    position: absolute;
    left: 10%; right: 10%; top: 8%; bottom: 8%;
    background-color: rgba(9, 11, 12, 0.94);
    border-width: 2px;
    border-color: var(--line, rgba(217, 196, 152, 0.27));
    padding: 20px;
}
.memorial-wall--comfort {
    border-color: var(--keepsake-gold);
}
.memorial-wall-title {
    font-size: 16px;
    color: var(--warm, #d3aa62);
    letter-spacing:  2px;
    margin-bottom: 12px;
}
.memorial-wall-empty {
    font-size: 13px;
    color: var(--muted, #938f84);
    margin-top: 24px;
}
.memorial-entry-list {
    flex-grow: 1;
    margin-top: 8px;
}
.memorial-entry-row {
    flex-direction: row;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-soft, rgba(217, 196, 152, 0.14));
}
.memorial-entry-name {
    flex-grow: 1;
    color: var(--pale, #e6e0d2);
    font-size: 13px;
}
.memorial-entry-day {
    color: var(--dim, #66675f);
    font-size: 11px;
}
.memorial-pay-respects-btn {
    margin-top: 12px;
    height: 32px;
    background-color: rgba(211, 170, 98, 0.2);
    border-color: var(--warm, #d3aa62);
    color: var(--pale, #e6e0d2);
}

/* 7 Terminal Prognosis Banner */
.terminal-prognosis-banner {
    height: 24px;
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
    border-width: 1px;
    border-color: var(--terminal-amber);
    background-color: rgba(9, 11, 12, 0.9);
    margin-bottom: 6px;
}
.terminal-prognosis-banner--completed {
    border-color: var(--terminal-golden);
}
.terminal-prognosis-banner--failed {
    border-color: var(--terminal-failed);
}
.terminal-prognosis-text {
    font-size: 11px;
    color: var(--terminal-amber);
    letter-spacing: 0.5px;
}

/* 8 Addiction Detox Indicator */
.addiction-detox-indicator {
    position: absolute;
    bottom: 4px;
    left: 4px;
    min-width: 14px;
    height: 14px;
    border-radius: 7px;
    padding: 0 4px;
    background-color: var(--addiction-orange);
    justify-content: center;
    align-items: center;
}
.addiction-detox-indicator--withdrawal {
    background-color: var(--addiction-withdrawal);
}
.addiction-detox-indicator--detox {
    background-color: var(--addiction-detox);
}
.addiction-detox-indicator--recovered {
    background-color: var(--addiction-recovered);
}
.addiction-detox-icon {
    font-size: 9px;
    color: var(--ink, #090b0c);
    -unity-text-align: middle-center;
}

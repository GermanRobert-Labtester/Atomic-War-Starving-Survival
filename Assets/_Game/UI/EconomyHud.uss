/*
 * Economy HUD — persistent mini-strip + toggleable detail panel.
 * Tokens: all from DiegeticHud.uss :root.
 * Mini-strip: always visible, top-right, compact day/supply/price readout.
 * Detail panel: toggleable [M], full goods catalog with prices + demand.
 */

/* ── Persistent mini-strip ────────────────────────────────────────────── */

.economy-strip {
    position: absolute;
    top: var(--hud-edge);
    right: var(--hud-edge);
    width: 220px;
    background-color: var(--ink-panel);
    border-left-width: 2px;
    border-left-color: var(--muted);
    border-right-width: 1px;
    border-right-color: var(--line-soft);
    border-top-width: 1px;
    border-top-color: var(--line-soft);
    border-bottom-width: 1px;
    border-bottom-color: var(--line-soft);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    flex-direction: row;
    align-items: center;
}

.economy-strip.hidden {
    display: none;
}

.economy-strip-day {
    -unity-font-definition: var(--font-mono);
    color: var(--pale);
    font-size: 10px;
    letter-spacing: 0.5px;
    width: 52px;
}

.economy-strip-divider {
    width: 1px;
    height: 14px;
    background-color: var(--line-soft);
    margin-left: 6px;
    margin-right: 6px;
}

.economy-strip-supply {
    -unity-font-definition: var(--font-semibold);
    font-size: 10px;
    letter-spacing: 0.6px;
    flex-grow: 1;
}

.economy-strip-supply--normal {
    color: var(--muted);
}

.economy-strip-supply--short {
    color: var(--hot);
}

.economy-strip-price {
    -unity-font-definition: var(--font-mono);
    color: var(--dim);
    font-size: 10px;
    letter-spacing: 0.3px;
    margin-left: 4px;
}

/* ── Detail panel (toggleable) ────────────────────────────────────────── */

.economy-panel {
    position: absolute;
    top: calc(var(--hud-edge) + 36px);
    right: var(--hud-edge);
    min-width: 380px;
    max-width: 500px;
    max-height: 480px;
}

.economy-panel.hidden {
    display: none;
}

.economy-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-soft);
    padding-bottom: 4px;
}

.economy-panel-summary {
    -unity-font-definition: var(--font-mono);
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.4px;
    white-space: normal;
}

/* ── Goods list ───────────────────────────────────────────────────────── */

.economy-goods-scroll {
    flex-direction: column;
    max-height: 340px;
}

.economy-goods-list {
    flex-direction: column;
}

.economy-good-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.economy-good-name {
    -unity-font-definition: var(--font-mono);
    color: var(--pale);
    font-size: 11px;
    letter-spacing: 0.3px;
    flex-grow: 1;
    white-space: normal;
}

.economy-good-category {
    -unity-font-definition: var(--font-mono);
    color: var(--dim);
    font-size: 9px;
    letter-spacing: 0.5px;
    width: 56px;
    -unity-text-align: middle-right;
}

.economy-good-price {
    -unity-font-definition: var(--font-mono);
    color: var(--hot);
    font-size: 11px;
    width: 48px;
    -unity-text-align: middle-right;
}

.economy-good-demand {
    -unity-font-definition: var(--font-mono);
    font-size: 10px;
    width: 40px;
    -unity-text-align: middle-right;
}

.economy-good-demand--normal {
    color: var(--muted);
}

.economy-good-demand--elevated {
    color: var(--hot);
}

.economy-good-demand--high {
    color: var(--exclusive);
}

.economy-good-demand--critical {
    color: var(--critical);
}

/* ── Price shock indicator ────────────────────────────────────────────── */

.economy-shock-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: var(--line-soft);
}

.economy-shock-label {
    -unity-font-definition: var(--font-semibold);
    color: var(--exclusive);
    font-size: 10px;
    letter-spacing: 0.8px;
    flex-grow: 1;
}

.economy-shock-value {
    -unity-font-definition: var(--font-mono);
    color: var(--exclusive);
    font-size: 10px;
}

/* ── Empty state ──────────────────────────────────────────────────────── */

.economy-empty {
    -unity-font-definition: var(--font-mono);
    color: var(--dim);
    font-size: 10px;
    letter-spacing: 0.4px;
    -unity-text-align: middle-center;
    margin-top: 12px;
}

/* ── Footer hint ──────────────────────────────────────────────────────── */

.economy-hint {
    -unity-font-definition: var(--font-mono);
    color: var(--dim);
    font-size: 10px;
    letter-spacing: 0.5px;
    margin-top: 6px;
}

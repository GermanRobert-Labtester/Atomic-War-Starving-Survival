<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/DiegeticHud.uss" />
    <Style src="project://database/Assets/_Game/UI/UIBatch20_A.uss" />
    <ui:VisualElement name="power-flow-root" class="power-flow-modal hidden" picking-mode="Position">
        <ui:VisualElement class="dosimeter-header">
            <ui:Label name="power-title" class="ashfall-title" text="POWER FLOW SCHEMATIC" />
            <ui:Label name="power-status-tag" class="ashfall-mono" text="GRID OPTIMAL" />
        </ui:VisualElement>

        <ui:VisualElement class="air-filter-row">
            <ui:Label class="ashfall-mono" text="SUPPLY vs DEMAND" />
            <ui:Label name="supply-demand-val" class="ashfall-mono" text="120.0 KW / 85.0 KW" />
        </ui:VisualElement>

        <ui:VisualElement name="budget-track" class="power-budget-bar-track">
            <ui:VisualElement name="budget-fill" class="power-budget-bar-fill" />
        </ui:VisualElement>

        <!-- 8 Power Nodes Grid -->
        <ui:VisualElement name="power-grid-container" class="power-grid-8">
            <ui:VisualElement name="power-node-0" class="power-node-box node-active">
                <ui:Label name="node-0-name" class="power-node-name" text="VENTILATION" />
                <ui:Label name="node-0-load" class="power-node-load" text="15.0 KW" />
            </ui:VisualElement>
            <ui:VisualElement name="power-node-1" class="power-node-box node-active">
                <ui:Label name="node-1-name" class="power-node-name" text="WATER PUMP" />
                <ui:Label name="node-1-load" class="power-node-load" text="20.0 KW" />
            </ui:VisualElement>
            <ui:VisualElement name="power-node-2" class="power-node-box node-active">
                <ui:Label name="node-2-name" class="power-node-name" text="RAD RADAR" />
                <ui:Label name="node-2-load" class="power-node-load" text="10.0 KW" />
            </ui:VisualElement>
            <ui:VisualElement name="power-node-3" class="power-node-box node-active">
                <ui:Label name="node-3-name" class="power-node-name" text="LIGHTING" />
                <ui:Label name="node-3-load" class="power-node-load" text="5.0 KW" />
            </ui:VisualElement>
            <ui:VisualElement name="power-node-4" class="power-node-box node-active">
                <ui:Label name="node-4-name" class="power-node-name" text="HEATER A" />
                <ui:Label name="node-4-load" class="power-node-load" text="25.0 KW" />
            </ui:VisualElement>
            <ui:VisualElement name="power-node-5" class="power-node-box node-active">
                <ui:Label name="node-5-name" class="power-node-name" text="HEATER B" />
                <ui:Label name="node-5-load" class="power-node-load" text="10.0 KW" />
            </ui:VisualElement>
            <ui:VisualElement name="power-node-6" class="power-node-box">
                <ui:Label name="node-6-name" class="power-node-name" text="DEFENSE TURRET" />
                <ui:Label name="node-6-load" class="power-node-load" text="30.0 KW" />
            </ui:VisualElement>
            <ui:VisualElement name="power-node-7" class="power-node-box">
                <ui:Label name="node-7-name" class="power-node-name" text="RADIO ARRAY" />
                <ui:Label name="node-7-load" class="power-node-load" text="12.0 KW" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="blackout-warning" class="power-blackout-banner hidden" text="CRITICAL OVERLOAD — BLACKOUT IMMINENT" />
    </ui:VisualElement>
</ui:UXML>

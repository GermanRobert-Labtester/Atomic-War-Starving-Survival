%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: af36bf8c5f5b8da728c5e06e589e8133, type: 3}
  m_Name: DefaultFlashpointSequence
  m_EditorClassIdentifier: AtomicWar._Game.Flashpoint::AtomicWar._Game.Flashpoint.FlashpointSequenceSO
  sequenceId: default
  buildupDays:
  - day: 25
    audioCueId: audio_cue_civil_war_silence
    economyModifierId:
    worldFlagKey: flashpoint_buildup_day_25
    narrativeNote: "Day 25: The civilian broadcast cuts out mid-sentence. Dead air on every frequency."
  - day: 26
    audioCueId: audio_cue_trader_panic
    economyModifierId: trader_panic
    worldFlagKey: flashpoint_buildup_day_26
    narrativeNote: "Day 26: Traders stop haggling. They only want iodine, water, and fuel."
  - day: 27
    audioCueId: audio_cue_military_codes
    economyModifierId:
    worldFlagKey: flashpoint_buildup_day_27
    narrativeNote: "Day 27: An automated numbers station is the only thing on the military band."
  - day: 28
    audioCueId: audio_cue_news_anchor_panic
    economyModifierId:
    worldFlagKey: flashpoint_buildup_day_28
    narrativeNote: "Day 28: An international anchor tries to broadcast an evacuation order. The signal collapses."
  - day: 29
    audioCueId: audio_cue_war_silence
    economyModifierId:
    worldFlagKey: flashpoint_buildup_day_29
    narrativeNote: "Day 29: The shelling reaches a fever pitch, then stops. The silence is worse."
  economyModifiers:
  - id: trader_panic
    enableBarterOnlyMode: 1
    acceptedItemIds:
    - iodine_pills
    - clean_water
    - fuel
    demandSpikes:
    - itemId: iodine_pills
      multiplierDelta: 2
    - itemId: clean_water
      multiplierDelta: 1.5
    - itemId: fuel
      multiplierDelta: 1.5
  steps:
  - actionId: flash
    delayFromPreviousSeconds: 0
    cameraShakeAmplitude: 0
    narrativeNote: "White flash. No sound. Light travels faster than the blast."
  - actionId: emp
    delayFromPreviousSeconds: 4
    cameraShakeAmplitude: 0
    narrativeNote: "Flash ends. UI flickers. Electronics die. Radio goes dead. Morale hit."
  - actionId: shockwave
    delayFromPreviousSeconds: 0.5
    cameraShakeAmplitude: 0.1
    narrativeNote: "Sub-bass rumble. 35-55 Hz, 6-8s tail. Camera shake at 0.10. Dust falls from ceiling."
  - actionId: sirens
    delayFromPreviousSeconds: 4
    cameraShakeAmplitude: 0
    narrativeNote: "Hand-cranked / unshielded military sirens spool up. Muffled by the bunker walls."
  - actionId: weather_shift
    delayFromPreviousSeconds: 1.5
    cameraShakeAmplitude: 0
    narrativeNote: "Cold palette swap. First flakes of nuclear ash begin falling outside the hatch."
  - actionId: radiation_hud_unlock
    delayFromPreviousSeconds: 0
    cameraShakeAmplitude: 0
    narrativeNote: "Dosimeter and geiger audio hook become visible on the HUD."
  - actionId: complete
    delayFromPreviousSeconds: 0
    cameraShakeAmplitude: 0
    narrativeNote: "Choreography complete. The new normal begins."
  accessibility:
    defaultFlashSeconds: 4
    safeFlashSeconds: 1.5
    safeShakeMultiplier: 0.5
    safeDesaturateFlash: 1

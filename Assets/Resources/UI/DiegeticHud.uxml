<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/DiegeticHud.uss" />
    <Style src="project://database/Assets/_Game/UI/UIBatch11_A.uss" />
    <Style src="project://database/Assets/_Game/UI/UIBatch11_B.uss" />
    <Style src="project://database/Assets/_Game/UI/Phase11Widgets.uss" />
    <ui:VisualElement name="diegetic-root" class="diegetic-root" picking-mode="Ignore">
        <ui:VisualElement name="vitals-panel" class="diegetic-panel vitals-panel">
            <ui:Label name="vitals-clock" class="diegetic-title" text="DAY 1   00:00" />
            <ui:Label name="vitals-dose" class="diegetic-status" text="" />
            <ui:VisualElement name="vitals-needs" class="vitals-needs">
                <ui:VisualElement name="vitals-need-hunger" class="vitals-row">
                    <ui:Label name="vitals-need-hunger-label" class="vitals-row__label" text="HUNGER" />
                    <ui:VisualElement name="vitals-need-hunger-track" class="vitals-row__track">
                        <ui:VisualElement name="vitals-need-hunger-fill" class="vitals-row__fill" />
                    </ui:VisualElement>
                    <ui:Label name="vitals-need-hunger-value" class="vitals-row__value" text="--" />
                </ui:VisualElement>
                <ui:VisualElement name="vitals-need-thirst" class="vitals-row">
                    <ui:Label name="vitals-need-thirst-label" class="vitals-row__label" text="THIRST" />
                    <ui:VisualElement name="vitals-need-thirst-track" class="vitals-row__track">
                        <ui:VisualElement name="vitals-need-thirst-fill" class="vitals-row__fill" />
                    </ui:VisualElement>
                    <ui:Label name="vitals-need-thirst-value" class="vitals-row__value" text="--" />
                </ui:VisualElement>
                <ui:VisualElement name="vitals-need-fatigue" class="vitals-row">
                    <ui:Label name="vitals-need-fatigue-label" class="vitals-row__label" text="FATIGUE" />
                    <ui:VisualElement name="vitals-need-fatigue-track" class="vitals-row__track">
                        <ui:VisualElement name="vitals-need-fatigue-fill" class="vitals-row__fill" />
                    </ui:VisualElement>
                    <ui:Label name="vitals-need-fatigue-value" class="vitals-row__value" text="--" />
                </ui:VisualElement>
                <ui:VisualElement name="vitals-need-warmth" class="vitals-row">
                    <ui:Label name="vitals-need-warmth-label" class="vitals-row__label" text="WARMTH" />
                    <ui:VisualElement name="vitals-need-warmth-track" class="vitals-row__track">
                        <ui:VisualElement name="vitals-need-warmth-fill" class="vitals-row__fill" />
                    </ui:VisualElement>
                    <ui:Label name="vitals-need-warmth-value" class="vitals-row__value" text="--" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="vitals-hint" class="diegetic-hint" text="[F1] eat  ·  [F2] drink  ·  [SPACE] pause  ·  [F5] save" />
        </ui:VisualElement>

        <ui:VisualElement name="event-panel" class="diegetic-panel event-panel hidden">
            <ui:Label name="event-title" class="diegetic-title" text="" />
            <ui:Label name="event-body" class="diegetic-body" text="" />
            <ui:VisualElement name="event-choices" class="event-choices" />
        </ui:VisualElement>

        <ui:VisualElement name="hatch-panel" class="diegetic-panel hatch-panel hidden">
            <ui:Label name="hatch-title" class="diegetic-title" text="HATCH DEFENSE" />
            <ui:Label name="hatch-status" class="diegetic-status" text="" />
            <ui:Label name="hatch-ammo" class="diegetic-body" text="" />
            <ui:Label name="hatch-arms" class="diegetic-body emphasis" text="" />
            <ui:Label name="hatch-hint" class="diegetic-hint" text="[H] close  ·  [B] workbench upgrades" />
        </ui:VisualElement>

        <ui:VisualElement name="encounter-panel" class="diegetic-panel encounter-panel">
            <ui:Label name="encounter-title" class="diegetic-title" text="FIELD CONTACT" />
            <ui:Label name="encounter-status" class="diegetic-status" text="ENCOUNTER LOG: quiet." />
            <ui:VisualElement name="encounter-list" class="encounter-list" />
            <ui:Label name="encounter-hint" class="diegetic-hint" text="Expedition combat feeds this strip." />
        </ui:VisualElement>

        <ui:VisualElement name="stores-panel" class="diegetic-panel stores-panel hidden">
            <ui:Label name="stores-title" class="diegetic-title" text="STORES FOCUS" />
            <ui:Label name="stores-summary" class="diegetic-status" text="" />
            <ui:Label name="stores-tooltip" class="diegetic-body" text="" />
            <ui:Label name="stores-hint" class="diegetic-hint" text="[I] next  ·  [Shift+I] prev  ·  [E] use" />
        </ui:VisualElement>

        <ui:VisualElement name="workbench-panel" class="diegetic-panel workbench-panel hidden">
            <ui:Label name="workbench-body" class="diegetic-body workbench-readout" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="endgame-panel" class="diegetic-panel endgame-panel hidden">
            <ui:Label name="endgame-title" class="diegetic-title" text="CAMPAIGN OVER" />
            <ui:Label name="endgame-status" class="diegetic-status" text="" />
            <ui:Label name="endgame-body" class="diegetic-body endgame-readout" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="power-grid-panel" class="diegetic-panel power-grid-panel hidden">
            <ui:Label name="power-grid-title" class="diegetic-title" text="POWER BUDGET" />
            <ui:Label name="power-grid-budget" class="diegetic-status" text="" />
            <ui:Label name="power-grid-sources" class="diegetic-body power-grid-readout" text="" />
            <ui:Label name="power-grid-loads" class="diegetic-body power-grid-readout" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="scavenge-panel" class="diegetic-panel scavenge-panel hidden">
            <ui:Label name="scavenge-body" class="diegetic-body scavenge-readout" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="overflow-crate-panel" class="diegetic-panel overflow-crate-panel hidden">
            <ui:Label name="overflow-crate-body" class="diegetic-body overflow-crate-readout" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="field-gear-loadout-panel" class="diegetic-panel field-gear-loadout-panel hidden">
            <ui:Label name="field-gear-loadout-body" class="diegetic-body field-gear-loadout-readout" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="bunker-rationing-panel" class="diegetic-panel bunker-rationing-panel hidden">
            <ui:Label name="bunker-rationing-body" class="diegetic-body bunker-rationing-readout" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="water-purification-panel" class="diegetic-panel water-purification-panel hidden">
            <ui:Label name="water-purification-body" class="diegetic-body water-purification-readout" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="air-heat-management-panel" class="diegetic-panel air-heat-management-panel hidden">
            <ui:Label name="air-heat-management-body" class="diegetic-body air-heat-management-readout" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="bunker-maintenance-panel" class="diegetic-panel bunker-maintenance-panel hidden">
            <ui:Label name="bunker-maintenance-body" class="diegetic-body bunker-maintenance-readout" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="survivor-task-board-panel" class="diegetic-panel survivor-task-board-panel hidden">
            <ui:Label name="survivor-task-board-body" class="diegetic-body survivor-task-board-readout" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="faction-pressure-panel" class="diegetic-panel faction-pressure-panel hidden">
            <ui:Label name="faction-pressure-title" class="diegetic-title" text="FACTION PRESSURE" />
            <ui:Label name="faction-pressure-body" class="diegetic-body faction-pressure-readout" text="" />
            <ui:Label name="faction-pressure-hint" class="diegetic-hint" text="Compliant. Patrolled. Tithed. Fed. Or not." />
        </ui:VisualElement>

        <!-- ═══════════════════════════════════════════════════════════════
             BATCH 20 UI ELEMENTS — produced 2026-08-12
             Each panel is controlled by its respective MonoBehaviour.
             The class contracts (panel positions) are defined in
             UIBatch20_A.uss and UIBatch20_B.uss.
             ═══════════════════════════════════════════════════════════════ -->

        <!-- 01 Radiation Dosimeter Widget — left-side, below vitals -->
        <ui:VisualElement name="radiation-dosimeter-root" class="diegetic-panel batch20-rad-dosimeter hidden" picking-mode="Ignore">
            <ui:Label name="rad-dose-value"    class="diegetic-title" text="0 mSv" />
            <ui:Label name="rad-rate-value"    class="diegetic-status" text="DOSE RATE: 0.0 mSv/hr" />
            <ui:VisualElement name="rad-segments" class="rad-arc-segments">
                <ui:VisualElement name="rad-seg-00" class="rad-seg" />
                <ui:VisualElement name="rad-seg-01" class="rad-seg" />
                <ui:VisualElement name="rad-seg-02" class="rad-seg" />
                <ui:VisualElement name="rad-seg-03" class="rad-seg" />
                <ui:VisualElement name="rad-seg-04" class="rad-seg" />
                <ui:VisualElement name="rad-seg-05" class="rad-seg" />
                <ui:VisualElement name="rad-seg-06" class="rad-seg" />
                <ui:VisualElement name="rad-seg-07" class="rad-seg" />
                <ui:VisualElement name="rad-seg-08" class="rad-seg" />
                <ui:VisualElement name="rad-seg-09" class="rad-seg" />
            </ui:VisualElement>
            <ui:Label name="rad-status-label"  class="diegetic-body" text="SAFE" />
            <ui:Label name="rad-iodine-label"  class="diegetic-hint" text="IODINE PILLS: 0" />
        </ui:VisualElement>

        <!-- 02 Geiger Sweep Gauge — left-side, inline below dosimeter -->
        <ui:VisualElement name="geiger-sweep-root" class="diegetic-panel batch20-geiger hidden" picking-mode="Ignore">
            <ui:Label name="geiger-cpm-label"    class="diegetic-title" text="0 CPM" />
            <ui:VisualElement name="geiger-bars" class="geiger-bar-row">
                <ui:VisualElement name="geiger-bar-00" class="geiger-bar" />
                <ui:VisualElement name="geiger-bar-01" class="geiger-bar" />
                <ui:VisualElement name="geiger-bar-02" class="geiger-bar" />
                <ui:VisualElement name="geiger-bar-03" class="geiger-bar" />
                <ui:VisualElement name="geiger-bar-04" class="geiger-bar" />
            </ui:VisualElement>
            <ui:Label name="geiger-status-label" class="diegetic-status" text="CLEAR" />
        </ui:VisualElement>

        <!-- 03 Air Filter Integrity Bar — top-centre -->
        <ui:VisualElement name="air-filter-root" class="diegetic-panel batch20-air-filter hidden" picking-mode="Ignore">
            <ui:Label name="air-filter-integrity-label"  class="diegetic-title"  text="FILTER: 100%" />
            <ui:VisualElement name="air-filter-track" class="air-filter-track">
                <ui:VisualElement name="air-filter-fill"  class="air-filter-fill" />
            </ui:VisualElement>
            <ui:Label name="air-filter-countdown-label"  class="diegetic-status" text="CHANGE IN: -- days" />
            <ui:Label name="air-filter-toxicity-label"   class="diegetic-body"   text="AIR TOXICITY: 0%" />
            <ui:Label name="air-filter-state-label"      class="diegetic-hint"   text="OPERATIONAL" />
        </ui:VisualElement>

        <!-- 04 Fallout Storm Warning Banner — top-centre, slides in -->
        <ui:VisualElement name="fallout-storm-root" class="diegetic-panel batch20-storm-banner hidden">
            <ui:Label name="storm-name-label"      class="diegetic-title"  text="" />
            <ui:Label name="storm-wind-label"      class="diegetic-status" text="" />
            <ui:Label name="storm-intensity-label" class="diegetic-body"   text="" />
            <ui:VisualElement name="storm-countdown-track" class="storm-countdown-track">
                <ui:VisualElement name="storm-countdown-fill" class="storm-countdown-fill" />
            </ui:VisualElement>
            <ui:Label name="storm-countdown-label" class="diegetic-hint"   text="" />
        </ui:VisualElement>

        <!-- 05 Survivor Portrait Card — reusable card widget -->
        <ui:VisualElement name="survivor-portrait-root" class="diegetic-panel batch20-portrait-card hidden">
            <ui:VisualElement name="terminal-prognosis-root" class="terminal-prognosis-banner hidden" picking-mode="Ignore">
                <ui:Label name="terminal-prognosis-text" class="terminal-prognosis-text" text="" />
            </ui:VisualElement>
            <ui:Label name="survivor-name-label"      class="diegetic-title"  text="" />
            <ui:Label name="survivor-role-label"      class="diegetic-status" text="" />
            <ui:VisualElement name="moral-branch-root" class="moral-branch-display hidden" picking-mode="Ignore">
                <ui:Label name="moral-branch-icon" class="moral-branch-icon" text="" />
                <ui:Label name="moral-branch-label" class="moral-branch-label" text="" />
            </ui:VisualElement>
            <ui:Label name="survivor-blood-type-label" class="survivor-blood-badge" text="" />
            <ui:VisualElement name="hypervigilance-indicator-root" class="hypervigilance-indicator hidden" picking-mode="Ignore">
                <ui:Label name="hypervigilance-eye" class="hypervigilance-eye" text="" />
            </ui:VisualElement>
            <ui:VisualElement name="addiction-detox-root" class="addiction-detox-indicator hidden" picking-mode="Ignore">
                <ui:Label name="addiction-detox-icon" class="addiction-detox-icon" text="" />
            </ui:VisualElement>
            <ui:VisualElement name="survivor-stat-rows" class="survivor-stat-rows">
                <ui:VisualElement name="survivor-health-track"  class="vitals-row__track"><ui:VisualElement name="survivor-health-fill"  class="vitals-row__fill" /></ui:VisualElement>
                <ui:VisualElement name="survivor-morale-track"  class="vitals-row__track"><ui:VisualElement name="survivor-morale-fill"  class="vitals-row__fill" /></ui:VisualElement>
                <ui:VisualElement name="survivor-fatigue-track" class="vitals-row__track"><ui:VisualElement name="survivor-fatigue-fill" class="vitals-row__fill" /></ui:VisualElement>
                <ui:VisualElement name="survivor-rad-track"     class="vitals-row__track"><ui:VisualElement name="survivor-rad-fill"     class="vitals-row__fill" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="survivor-status-label"    class="diegetic-body emphasis" text="" />
            <ui:VisualElement name="keepsake-slot-root" class="keepsake-slot hidden" picking-mode="Ignore">
                <ui:VisualElement name="slot-border" class="slot-border" />
                <ui:Label name="keepsake-slot-icon" class="keepsake-slot-icon item-icon" text="" />
                <ui:VisualElement name="keepsake-crack-overlay" class="keepsake-crack-overlay cracked-overlay" />
                <ui:VisualElement name="grief-vignette" class="grief-vignette" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 06 Moral Decay Meter — left sidebar -->
        <ui:VisualElement name="moral-decay-root" class="diegetic-panel batch20-moral-decay hidden" picking-mode="Ignore">
            <ui:Label name="moral-pct-label"      class="diegetic-title"  text="MORALE: 100%" />
            <ui:VisualElement name="moral-pips" class="moral-pip-column">
                <ui:VisualElement name="moral-pip-00" class="moral-pip" />
                <ui:VisualElement name="moral-pip-01" class="moral-pip" />
                <ui:VisualElement name="moral-pip-02" class="moral-pip" />
                <ui:VisualElement name="moral-pip-03" class="moral-pip" />
                <ui:VisualElement name="moral-pip-04" class="moral-pip" />
                <ui:VisualElement name="moral-pip-05" class="moral-pip" />
                <ui:VisualElement name="moral-pip-06" class="moral-pip" />
                <ui:VisualElement name="moral-pip-07" class="moral-pip" />
                <ui:VisualElement name="moral-pip-08" class="moral-pip" />
                <ui:VisualElement name="moral-pip-09" class="moral-pip" />
            </ui:VisualElement>
            <ui:Label name="moral-breaking-label" class="diegetic-body emphasis" text="" />
        </ui:VisualElement>

        <!-- 07 Ration Allocation Dial — centre modal -->
        <ui:VisualElement name="ration-dial-root" class="diegetic-panel batch20-ration-dial hidden">
            <ui:Label name="ration-survivor-label" class="diegetic-title" text="" />
            <ui:Button name="ration-slot-btn-0"    class="ration-slot-btn">
                <ui:Label name="ration-slot-label-0" class="diegetic-status" text="— EMPTY —" />
            </ui:Button>
            <ui:Button name="ration-slot-btn-1"    class="ration-slot-btn">
                <ui:Label name="ration-slot-label-1" class="diegetic-status" text="— EMPTY —" />
            </ui:Button>
            <ui:Button name="ration-slot-btn-2"    class="ration-slot-btn">
                <ui:Label name="ration-slot-label-2" class="diegetic-status" text="— EMPTY —" />
            </ui:Button>
            <ui:VisualElement name="ration-adjust-row" class="ration-adjust-row">
                <ui:Button name="ration-dec-btn" class="ration-adj-btn" text="−" />
                <ui:Label  name="ration-calorie-label" class="diegetic-status" text="TOTAL: 0 kcal ×1" />
                <ui:Button name="ration-inc-btn" class="ration-adj-btn" text="+" />
            </ui:VisualElement>
            <ui:Button name="ration-confirm-btn" class="ration-confirm-btn" text="CONFIRM" />
            <ui:Label  name="ration-skip-label"  class="diegetic-hint" text="[SKIP]" />
        </ui:VisualElement>

        <!-- 08 Water Purity Gauge — right sidebar -->
        <ui:VisualElement name="water-purity-root" class="diegetic-panel batch20-water-purity hidden" picking-mode="Ignore">
            <ui:Label name="water-reserve-label"       class="diegetic-title"  text="RESERVE: 0 L" />
            <ui:Label name="water-status-label"        class="diegetic-status" text="IDLE" />
            <ui:VisualElement name="water-purity-track" class="water-purity-track">
                <ui:VisualElement name="water-purity-fill" class="water-purity-fill" />
            </ui:VisualElement>
            <ui:Label name="water-output-label"        class="diegetic-body"   text="OUTPUT: 0 L/day" />
            <ui:Label name="water-contamination-label" class="diegetic-hint"   text="CONTAMINATION: 0%" />
        </ui:VisualElement>

        <!-- 09 Temperature Readout Widget — top-right -->
        <ui:VisualElement name="temperature-readout-root" class="diegetic-panel batch20-temperature hidden" picking-mode="Ignore">
            <ui:Label name="temp-internal-label" class="diegetic-title"  text="INT: 0°C" />
            <ui:Label name="temp-external-label" class="diegetic-status" text="EXT: 0°C" />
            <ui:Label name="temp-status-label"   class="diegetic-body"   text="OPTIMAL" />
            <ui:Label name="temp-fuel-label"     class="diegetic-body"   text="FUEL: 0h" />
            <ui:Label name="temp-source-label"   class="diegetic-hint"   text="NO SOURCE" />
        </ui:VisualElement>

        <!-- 10 Power Flow Schematic — top-centre modal -->
        <ui:VisualElement name="power-flow-root" class="diegetic-panel batch20-power-flow hidden">
            <ui:Label name="power-budget-label"   class="diegetic-title"  text="SUPPLY: 0 kW   DEMAND: 0 kW" />
            <ui:VisualElement name="power-supply-track" class="power-budget-track">
                <ui:VisualElement name="power-supply-fill" class="power-supply-fill" />
            </ui:VisualElement>
            <ui:VisualElement name="power-demand-track" class="power-budget-track">
                <ui:VisualElement name="power-demand-fill" class="power-demand-fill" />
            </ui:VisualElement>
            <ui:Label name="power-blackout-label" class="diegetic-body emphasis" text="" />
            <ui:VisualElement name="power-nodes-grid" class="power-nodes-grid">
                <ui:VisualElement name="power-node-00" class="power-node">
                    <ui:Label name="power-node-00-name" class="diegetic-body" text="NODE 0" />
                    <ui:Label name="power-node-00-load" class="diegetic-hint" text="0 kW" />
                </ui:VisualElement>
                <ui:VisualElement name="power-node-01" class="power-node">
                    <ui:Label name="power-node-01-name" class="diegetic-body" text="NODE 1" />
                    <ui:Label name="power-node-01-load" class="diegetic-hint" text="0 kW" />
                </ui:VisualElement>
                <ui:VisualElement name="power-node-02" class="power-node">
                    <ui:Label name="power-node-02-name" class="diegetic-body" text="NODE 2" />
                    <ui:Label name="power-node-02-load" class="diegetic-hint" text="0 kW" />
                </ui:VisualElement>
                <ui:VisualElement name="power-node-03" class="power-node">
                    <ui:Label name="power-node-03-name" class="diegetic-body" text="NODE 3" />
                    <ui:Label name="power-node-03-load" class="diegetic-hint" text="0 kW" />
                </ui:VisualElement>
                <ui:VisualElement name="power-node-04" class="power-node">
                    <ui:Label name="power-node-04-name" class="diegetic-body" text="NODE 4" />
                    <ui:Label name="power-node-04-load" class="diegetic-hint" text="0 kW" />
                </ui:VisualElement>
                <ui:VisualElement name="power-node-05" class="power-node">
                    <ui:Label name="power-node-05-name" class="diegetic-body" text="NODE 5" />
                    <ui:Label name="power-node-05-load" class="diegetic-hint" text="0 kW" />
                </ui:VisualElement>
                <ui:VisualElement name="power-node-06" class="power-node">
                    <ui:Label name="power-node-06-name" class="diegetic-body" text="NODE 6" />
                    <ui:Label name="power-node-06-load" class="diegetic-hint" text="0 kW" />
                </ui:VisualElement>
                <ui:VisualElement name="power-node-07" class="power-node">
                    <ui:Label name="power-node-07-name" class="diegetic-body" text="NODE 7" />
                    <ui:Label name="power-node-07-load" class="diegetic-hint" text="0 kW" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 11 Faction Pressure Ring — bottom-right -->
        <ui:VisualElement name="faction-pressure-root" class="diegetic-panel batch20-faction-ring hidden" picking-mode="Ignore">
            <ui:Label name="faction-title"           class="diegetic-title"  text="FACTION PRESSURE" />
            <ui:Label name="faction-dominant-label"  class="diegetic-status" text="" />
            <ui:VisualElement name="faction-rings" class="faction-ring-stack">
                <ui:VisualElement name="faction-ring-00" class="faction-ring faction-ring--garrison">
                    <ui:VisualElement name="faction-ring-00-fill" class="faction-ring-fill" />
                </ui:VisualElement>
                <ui:VisualElement name="faction-ring-01" class="faction-ring faction-ring--militia">
                    <ui:VisualElement name="faction-ring-01-fill" class="faction-ring-fill" />
                </ui:VisualElement>
                <ui:VisualElement name="faction-ring-02" class="faction-ring faction-ring--cultists">
                    <ui:VisualElement name="faction-ring-02-fill" class="faction-ring-fill" />
                </ui:VisualElement>
                <ui:VisualElement name="faction-ring-03" class="faction-ring faction-ring--warlords">
                    <ui:VisualElement name="faction-ring-03-fill" class="faction-ring-fill" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="faction-siege-label"     class="diegetic-hint"   text="" />
        </ui:VisualElement>

        <!-- 12 Expedition Countdown Timer — bottom-left -->
        <ui:VisualElement name="expedition-countdown-root" class="diegetic-panel batch20-expedition-timer hidden" picking-mode="Ignore">
            <ui:Label name="expedition-title"           class="diegetic-title"  text="EXPEDITION" />
            <ui:Label name="expedition-survivor-label"  class="diegetic-status" text="" />
            <ui:Label name="expedition-zone-label"      class="diegetic-body"   text="" />
            <ui:Label name="expedition-elapsed-label"   class="diegetic-body"   text="ELAPSED: 0:00" />
            <ui:Label name="expedition-eta-label"       class="diegetic-body"   text="ETA: --:--" />
            <ui:VisualElement name="expedition-danger-track" class="expedition-danger-track">
                <ui:VisualElement name="expedition-danger-fill" class="expedition-danger-fill" />
            </ui:VisualElement>
            <ui:Label name="expedition-overdue-label"   class="diegetic-body emphasis" text="" />
        </ui:VisualElement>

        <!-- 13 Radio Signal Strength Bar — in-panel widget -->
        <ui:VisualElement name="radio-signal-root" class="diegetic-panel batch20-radio-signal hidden" picking-mode="Ignore">
            <ui:Label name="radio-freq-label"    class="diegetic-title"  text="" />
            <ui:VisualElement name="radio-signal-bars" class="radio-signal-bars">
                <ui:VisualElement name="radio-bar-00" class="radio-bar" />
                <ui:VisualElement name="radio-bar-01" class="radio-bar" />
                <ui:VisualElement name="radio-bar-02" class="radio-bar" />
                <ui:VisualElement name="radio-bar-03" class="radio-bar" />
                <ui:VisualElement name="radio-bar-04" class="radio-bar" />
            </ui:VisualElement>
            <ui:Label name="radio-station-label" class="diegetic-status" text="SCANNING" />
            <ui:Label name="radio-noise-label"   class="diegetic-hint"   text="NOISE: 0%" />
        </ui:VisualElement>

        <!-- 14 Craft Queue Strip — bottom-centre -->
        <ui:VisualElement name="craft-queue-root" class="diegetic-panel batch20-craft-queue hidden">
            <ui:Label name="craft-queue-title" class="diegetic-title" text="CRAFT QUEUE" />
            <ui:VisualElement name="craft-slots" class="craft-slot-row">
                <ui:VisualElement name="craft-slot-00" class="craft-slot">
                    <ui:Label name="craft-slot-00-name"     class="diegetic-body"   text="" />
                    <ui:VisualElement name="craft-slot-00-track" class="vitals-row__track">
                        <ui:VisualElement name="craft-slot-00-fill" class="vitals-row__fill" />
                    </ui:VisualElement>
                    <ui:Label name="craft-slot-00-eta"      class="diegetic-hint"   text="" />
                    <ui:Button name="craft-slot-00-cancel"  class="craft-cancel-btn" text="✕" />
                </ui:VisualElement>
                <ui:VisualElement name="craft-slot-01" class="craft-slot">
                    <ui:Label name="craft-slot-01-name"     class="diegetic-body"   text="" />
                    <ui:VisualElement name="craft-slot-01-track" class="vitals-row__track">
                        <ui:VisualElement name="craft-slot-01-fill" class="vitals-row__fill" />
                    </ui:VisualElement>
                    <ui:Label name="craft-slot-01-eta"      class="diegetic-hint"   text="" />
                    <ui:Button name="craft-slot-01-cancel"  class="craft-cancel-btn" text="✕" />
                </ui:VisualElement>
                <ui:VisualElement name="craft-slot-02" class="craft-slot">
                    <ui:Label name="craft-slot-02-name"     class="diegetic-body"   text="" />
                    <ui:VisualElement name="craft-slot-02-track" class="vitals-row__track">
                        <ui:VisualElement name="craft-slot-02-fill" class="vitals-row__fill" />
                    </ui:VisualElement>
                    <ui:Label name="craft-slot-02-eta"      class="diegetic-hint"   text="" />
                    <ui:Button name="craft-slot-02-cancel"  class="craft-cancel-btn" text="✕" />
                </ui:VisualElement>
                <ui:VisualElement name="craft-slot-03" class="craft-slot">
                    <ui:Label name="craft-slot-03-name"     class="diegetic-body"   text="" />
                    <ui:VisualElement name="craft-slot-03-track" class="vitals-row__track">
                        <ui:VisualElement name="craft-slot-03-fill" class="vitals-row__fill" />
                    </ui:VisualElement>
                    <ui:Label name="craft-slot-03-eta"      class="diegetic-hint"   text="" />
                    <ui:Button name="craft-slot-03-cancel"  class="craft-cancel-btn" text="✕" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 15 Alert Toast Notification — top-centre, stacking transient -->
        <ui:VisualElement name="alert-toast-root" class="batch20-toast-stack" picking-mode="Ignore">
            <!-- Toast items generated dynamically by AlertToastNotification.cs -->
        </ui:VisualElement>

        <!-- 16 Bunker Floor Map Miniature — bottom-right -->
        <ui:VisualElement name="bunker-map-root" class="diegetic-panel batch20-bunker-map hidden" picking-mode="Ignore">
            <ui:Label name="bunker-map-title"  class="diegetic-title" text="BUNKER MAP" />
            <ui:VisualElement name="bunker-map-grid" class="bunker-map-grid">
                <!-- Room cells generated dynamically by BunkerFloorMapMiniature.cs -->
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 17 Day/Night Arc Clock — top-left inline -->
        <ui:VisualElement name="day-night-clock-root" class="diegetic-panel batch20-day-clock hidden" picking-mode="Ignore">
            <ui:Label name="day-clock-day-label"    class="diegetic-title"  text="DAY 1" />
            <ui:Label name="day-clock-time-label"   class="diegetic-status" text="00:00" />
            <ui:VisualElement name="day-clock-arc-track" class="day-clock-arc-track">
                <ui:VisualElement name="day-clock-arc-fill" class="day-clock-arc-fill" />
            </ui:VisualElement>
            <ui:Label name="day-clock-season-label" class="diegetic-hint"   text="NUCLEAR WINTER" />
        </ui:VisualElement>

        <!-- 18 Blood Type Indicator — in-card widget -->
        <ui:VisualElement name="blood-type-root" class="blood-type-indicator hidden" picking-mode="Ignore">
            <ui:Label name="blood-type-badge"     class="blood-type-badge"  text="" />
            <ui:Label name="blood-type-compat"    class="diegetic-hint"     text="" />
        </ui:VisualElement>

        <!-- 19 Loot Haul Ticker — bottom-centre transient -->
        <ui:VisualElement name="loot-haul-root" class="diegetic-panel batch20-loot-ticker hidden">
            <ui:Label name="loot-haul-item-label" class="diegetic-status" text="" />
            <ui:Label name="loot-haul-qty-label"  class="diegetic-title"  text="" />
            <ui:VisualElement name="loot-dismiss-track" class="loot-dismiss-track">
                <ui:VisualElement name="loot-dismiss-fill" class="loot-dismiss-fill" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 20 Endgame Victory Path Tracker — centre modal -->
        <ui:VisualElement name="endgame-victory-root" class="diegetic-panel batch20-victory-tracker hidden">
            <ui:Label name="victory-title"         class="diegetic-title"  text="CAMPAIGN RESOLUTION" />
            <ui:Label name="victory-day-label"     class="diegetic-status" text="" />
            <ui:VisualElement name="victory-paths" class="victory-path-list">
                <!-- Path rows generated dynamically by EndgameVictoryPathTracker.cs -->
            </ui:VisualElement>
            <ui:Label name="victory-score-label"   class="diegetic-hint"   text="SURVIVAL SCORE: 0 pts" />
        </ui:VisualElement>

        <!-- ═══════════════════════════════════════════════════════════════
             BATCH 11 — Expansion Phase 11 HUD widgets
             ═══════════════════════════════════════════════════════════════ -->

        <ui:VisualElement name="phase11-overlay-layer" class="phase11-overlay-layer" picking-mode="Ignore">
            <ui:VisualElement name="phantom-memory-vignette-root" class="phantom-memory-vignette hidden" picking-mode="Ignore">
                <ui:VisualElement name="vignette-gradient" class="vignette-gradient" />
                <ui:Label name="phantom-memory-text" class="phantom-memory-text memory-text" text="" />
            </ui:VisualElement>
            <ui:VisualElement name="hypervigilance-flash-root" class="hypervigilance-flash hidden" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- 1 Radiation Phase Indicator -->
        <ui:VisualElement name="radiation-phase-root" class="diegetic-panel batch11-rad-phase hidden" picking-mode="Ignore">
            <ui:VisualElement name="radiation-phase-indicator" class="radiation-phase-indicator">
                <ui:VisualElement name="radiation-phase-dot" class="radiation-phase-dot" />
                <ui:Label name="radiation-phase-label" class="radiation-phase-label" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 6 Memorial Wall modal -->
        <ui:VisualElement name="memorial-wall-root" class="memorial-wall hidden">
            <ui:VisualElement name="wall-background" class="wall-background" />
            <ui:Label name="memorial-wall-title" class="memorial-wall-title" text="MEMORIAL WALL" />
            <ui:Label name="memorial-wall-empty" class="memorial-wall-empty empty-state" text="" />
            <ui:ScrollView name="memorial-entry-list" class="memorial-entry-list entries-scroll" />
            <ui:Button name="memorial-pay-respects-btn" class="memorial-pay-respects-btn pay-respects-button" text="PAY RESPECTS (1h)" />
        </ui:VisualElement>

        <!-- ═══════════════════════════════════════════════════════════════
             EXPANSIONS 3 & 4 + DEEP LORE — overlay panels
             ═══════════════════════════════════════════════════════════════ -->

        <ui:Template src="project://database/Assets/_Game/UI/LocationDetailPanel.uxml" name="LocationDetailPanelTemplate" />
        <ui:Instance template="LocationDetailPanelTemplate" />

        <ui:Template src="project://database/Assets/_Game/UI/ItemConditionBadge.uxml" name="ItemConditionBadgeTemplate" />
        <ui:Instance template="ItemConditionBadgeTemplate" />

        <ui:Template src="project://database/Assets/_Game/UI/QuestlineProgressTracker.uxml" name="QuestlineProgressTrackerTemplate" />
        <ui:Instance template="QuestlineProgressTrackerTemplate" />

        <ui:Template src="project://database/Assets/_Game/UI/SiegeStatusHUD.uxml" name="SiegeStatusHUDTemplate" />
        <ui:Instance template="SiegeStatusHUDTemplate" />

        <ui:Template src="project://database/Assets/_Game/UI/FactionIntelligencePanel.uxml" name="FactionIntelligencePanelTemplate" />
        <ui:Instance template="FactionIntelligencePanelTemplate" />

        <ui:Template src="project://database/Assets/_Game/UI/VehicleStatusPanel.uxml" name="VehicleStatusPanelTemplate" />
        <ui:Instance template="VehicleStatusPanelTemplate" />

        <ui:Template src="project://database/Assets/_Game/UI/TacticalCommandBar.uxml" name="TacticalCommandBarTemplate" />
        <ui:Instance template="TacticalCommandBarTemplate" />

        <ui:Template src="project://database/Assets/_Game/UI/QuestlineStageTracker.uxml" name="QuestlineStageTrackerTemplate" />
        <ui:Instance template="QuestlineStageTrackerTemplate" />

        <ui:Template src="project://database/Assets/_Game/UI/LoreCodexPanel.uxml" name="LoreCodexPanelTemplate" />
        <ui:Instance template="LoreCodexPanelTemplate" />

        <ui:Template src="project://database/Assets/_Game/UI/FactionRelationshipMap.uxml" name="FactionRelationshipMapTemplate" />
        <ui:Instance template="FactionRelationshipMapTemplate" />

        <ui:Template src="project://database/Assets/_Game/UI/CharacterArcProgressPanel.uxml" name="CharacterArcProgressPanelTemplate" />
        <ui:Instance template="CharacterArcProgressPanelTemplate" />

    </ui:VisualElement>
</ui:UXML>

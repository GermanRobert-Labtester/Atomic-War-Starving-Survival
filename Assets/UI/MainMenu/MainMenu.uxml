<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/MainMenu/MainMenu.uss" />

    <!--
      LAST STATIC main menu.

      The five menu rows are NOT authored here: MainMenuController builds them
      into #menu-list from MainMenuModel, so the labels, detail lines and the
      order live in one testable place rather than being duplicated between
      markup and code. Everything else is fixed chrome and stays declarative.

      Every purely decorative layer is picking-mode="Ignore" so it cannot eat
      a click meant for a button underneath it.
    -->
    <ui:VisualElement name="game-shell" class="game-shell">

        <!-- Backdrop stack: photo, vignette, scanlines. -->
        <ui:VisualElement name="scene-image" class="scene-image" picking-mode="Ignore" />
        <ui:VisualElement name="scene-vignette" class="scene-vignette" picking-mode="Ignore" />
        <ui:VisualElement name="scanlines" class="scanlines" picking-mode="Ignore" />
        <ui:VisualElement name="top-rule" class="top-rule" picking-mode="Ignore" />

        <!-- Brand block: three ascending bars + wordmark. -->
        <ui:VisualElement name="brand-block" class="brand-block" picking-mode="Ignore">
            <ui:VisualElement class="brand-mark" picking-mode="Ignore">
                <ui:VisualElement class="brand-bar brand-bar--short" picking-mode="Ignore" />
                <ui:VisualElement class="brand-bar brand-bar--mid" picking-mode="Ignore" />
                <ui:VisualElement class="brand-bar brand-bar--tall" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="brand-text" picking-mode="Ignore">
                <ui:Label text="A TRANSMISSION FROM" class="eyebrow" picking-mode="Ignore" />
                <ui:VisualElement class="brand-title-row" picking-mode="Ignore">
                    <ui:Label text="LAST" class="brand-title" picking-mode="Ignore" />
                    <ui:Label text="STATIC" class="brand-title brand-title--accent" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Menu column. -->
        <ui:VisualElement name="menu-stage" class="menu-stage">
            <ui:Label text="// SHELTER INTERFACE" class="eyebrow" picking-mode="Ignore" />
            <ui:VisualElement class="menu-rule" picking-mode="Ignore">
                <ui:Label text="MAIN MENU" class="menu-rule__label" picking-mode="Ignore" />
                <ui:VisualElement class="menu-rule__line" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="menu-list" class="menu-list" />

            <ui:VisualElement class="menu-instruction" picking-mode="Ignore">
                <ui:Label text="&#8593; &#8595;" class="key-hint" picking-mode="Ignore" />
                <ui:Label text="NAVIGATE" class="menu-instruction__word" picking-mode="Ignore" />
                <ui:Label text="ENTER" class="key-hint" picking-mode="Ignore" />
                <ui:Label text="SELECT" class="menu-instruction__word" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Status readout, bottom right. -->
        <ui:VisualElement name="status-readout" class="status-readout" picking-mode="Ignore">
            <ui:VisualElement class="status-line status-line--signal" picking-mode="Ignore">
                <ui:VisualElement class="signal-dot" picking-mode="Ignore" />
                <ui:Label text="RELAY // ONLINE" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="status-build" text="BUILD 0.8.14 &#183; PRE-ALPHA" class="status-line" picking-mode="Ignore" />
            <ui:Label text="SECTOR 07 // KALININGRAD" class="status-line" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Footer strip. -->
        <ui:VisualElement name="footer-strip" class="footer-strip" picking-mode="Ignore">
            <ui:Label name="footer-credit" text="" class="footer-text" picking-mode="Ignore" />
            <ui:VisualElement class="footer-hint" picking-mode="Ignore">
                <ui:Label text="ESC" class="key-hint" picking-mode="Ignore" />
                <ui:Label text="SESSION OPTIONS" class="footer-text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!--
          One dialog shell, reused by all three dialogs. The controller swaps
          the copy and shows or hides the difficulty row and the settings body,
          so there is a single focus trap and a single set of transitions to
          get right rather than three near-identical copies.
        -->
        <ui:VisualElement name="dialog-backdrop" class="dialog-backdrop">
            <ui:VisualElement name="dialog-panel" class="dialog-panel">
                <ui:VisualElement class="dialog-scan" picking-mode="Ignore" />
                <ui:Label name="dialog-eyebrow" text="" class="eyebrow" picking-mode="Ignore" />
                <ui:Label name="dialog-title" text="" class="dialog-title" picking-mode="Ignore" />
                <ui:Label name="dialog-body" text="" class="dialog-body" picking-mode="Ignore" />

                <!-- New expedition only. -->
                <ui:VisualElement name="difficulty-row" class="difficulty-row">
                    <ui:Button name="difficulty-operative" class="difficulty">
                        <ui:Label name="difficulty-operative-label" text="OPERATIVE" class="difficulty__label" picking-mode="Ignore" />
                        <ui:Label name="difficulty-operative-detail" text="" class="difficulty__detail" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="difficulty-veteran" class="difficulty difficulty--last">
                        <ui:Label name="difficulty-veteran-label" text="VETERAN" class="difficulty__label" picking-mode="Ignore" />
                        <ui:Label name="difficulty-veteran-detail" text="" class="difficulty__detail" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- Settings only. -->
                <ui:VisualElement name="settings-body" class="settings-body">
                    <ui:VisualElement class="setting-row">
                        <ui:Label text="MASTER VOLUME" class="setting-label" picking-mode="Ignore" />
                        <ui:Slider name="setting-volume" low-value="0" high-value="1" class="setting-slider" />
                        <ui:Label name="setting-volume-value" text="100%" class="setting-value" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="setting-row">
                        <ui:Label text="FULLSCREEN" class="setting-label" picking-mode="Ignore" />
                        <ui:Toggle name="setting-fullscreen" class="setting-toggle" />
                    </ui:VisualElement>
                    <ui:VisualElement class="setting-row">
                        <ui:Label text="RESOLUTION" class="setting-label" picking-mode="Ignore" />
                        <ui:DropdownField name="setting-resolution" class="setting-dropdown" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="dialog-actions">
                    <ui:Button name="dialog-back" class="menu-button--compact">
                        <ui:Label text="&#9664;" class="compact-glyph" picking-mode="Ignore" />
                        <ui:Label name="dialog-back-label" text="BACK" class="compact-label" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="dialog-confirm" class="menu-button--compact menu-button--confirm">
                        <ui:Label name="dialog-confirm-label" text="" class="compact-label" picking-mode="Ignore" />
                        <ui:Label text="&#9654;" class="compact-glyph" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>


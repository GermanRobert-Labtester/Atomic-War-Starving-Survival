#!/usr/bin/env bash
# ASHFALL pre-commit secret scan — blocks commits that contain common secrets.
set -euo pipefail

matches=$(git diff --cached --name-only -z | xargs -0 grep -HnE \
  '(STITCH_API_KEY|sk-[a-zA-Z0-9]{20,}|AKIA[0-9A-Z]{16}|gh[opsr]_[a-zA-Z0-9]{36}|\b\d{4}[ -]?\d{4}[ -]?\d{4}[ -]?\d{4}\b)' \
  2>/dev/null || true)

if [ -n "$matches" ]; then
  echo "[secret-scan] BLOCKED: potential secret material detected:" >&2
  echo "$matches" >&2
  exit 1
fi

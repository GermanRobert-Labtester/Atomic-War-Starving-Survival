<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Ashfall.Core</RootNamespace>
    <AssemblyName>Ashfall.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!--
    The core SOURCE lives at ../Assets/Ashfall.Core/ and is compiled by the
    Godot host (via Ashfall.csproj) and these xunit tests from the same files.
    Do not copy core sources back into this folder.
  -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Assets/Ashfall.Core/**/*.cs" Exclude="../Assets/Ashfall.Core/AtomicWar.Ashfall.Core.asmdef" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>

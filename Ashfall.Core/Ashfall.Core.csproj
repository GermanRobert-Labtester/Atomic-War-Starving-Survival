<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Ashfall.Core</RootNamespace>
    <AssemblyName>Ashfall.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <!--
      Host DTOs are populated by JSON and are not nullable-analyzed at runtime;
      tuple nullability drift (CS8619/CS8620) and serializer-populated fields
      (CS0649/CS0169) are expected noise. CS8605/CS8629 are NOT suppressed:
      they flag real unboxing/.Value crash risks.
    -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0414;CS0067;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8765;CS8619;CS8620;CS0649;CS0169</NoWarn>
  </PropertyGroup>
  <!--
    The core SOURCE lives at ../Assets/Ashfall.Core/ and is compiled by the
    Godot host (via Ashfall.csproj) and these xunit tests from the same files.
    Do not copy core sources back into this folder.
  -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Assets/Ashfall.Core/**/*.cs" Exclude="../Assets/Ashfall.Core/AtomicWar.Ashfall.Core.asmdef" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>

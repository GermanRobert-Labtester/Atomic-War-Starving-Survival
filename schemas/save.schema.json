{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Save",
  "type": "object",
  "required": ["version", "player_id", "quests"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "player_id": { "type": "string", "minLength": 1 },
    "quests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quest_id", "state"],
        "properties": {
          "quest_id": { "type": "string" },
          "state": { "enum": ["active", "completed", "failed"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

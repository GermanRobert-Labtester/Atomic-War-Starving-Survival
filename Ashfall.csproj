<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>AtomicWar</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseSharedCompilation>false</UseSharedCompilation>
    <UseRazorBuildServer>false</UseRazorBuildServer>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <!--
      PERF-001 — opt-in lean local build. The host is one ~616k-LOC compilation
      (1383 src files + all of Assets/Ashfall.Core), so any single-file edit
      recompiles the whole assembly in Roslyn (Csc measured at 112.6s of a
      116.9s incremental build). The only deterministic, behavior-preserving
      lever is to compile fewer files: ASHFALL_BUILD_LEAN=1 excludes the same
      self-test/harness sources the shipping ExportRelease build already
      excludes (measured 116.9s -> 81.5s, -27%). The default build is UNCHANGED;
      this is for gameplay-iteration compile checks, not the test loop (which
      needs the self-tests). The real structural fix — compiling
      Assets/Ashfall.Core as its own assembly instead of into the host — is a
      larger change that needs separate approval.
    -->
    <AshfallIncludeSelfTests Condition="'$(AshfallIncludeSelfTests)' == '' and '$(ASHFALL_BUILD_LEAN)' == '1'">false</AshfallIncludeSelfTests>
    <!-- Godot uses ExportRelease for shipping exports. Debug/ExportDebug retain
         the CLI harness; an explicit property also supports development exports. -->
    <AshfallIncludeSelfTests Condition="'$(AshfallIncludeSelfTests)' == '' and '$(Configuration)' == 'ExportRelease'">false</AshfallIncludeSelfTests>
    <AshfallIncludeSelfTests Condition="'$(AshfallIncludeSelfTests)' == ''">true</AshfallIncludeSelfTests>
    <DefineConstants Condition="'$(AshfallIncludeSelfTests)' == 'true'">$(DefineConstants);ASHFALL_SELFTEST</DefineConstants>
    <!--
      Effective NoWarn policy (shared Directory.Build.props list plus this project's entries):
      CS0108/CS0114  — intentional member hiding in host sessions
      CS0414         — serializer-assigned fields flagged as unused
      CS0067         — public event surface wired by feature registration
      CS8600/CS8601  — JSON-populated DTO null conversions (known safe)
      CS8604/CS8618  — serializer-assigned reference fields
      CS8625         — null passed to non-nullable param in JSON paths
      CS8765         — interface/override nullability mismatch on DTOs
      CS8619/CS8620  — tuple nullability drift in host adapters
      CS0649/CS0169  — fields only written by JSON serializer
      CS8602         — NOT suppressed for production code: real null-dereference detection remains active
      CS8603         — suppressed by the shared list and this project list
      CS8605/CS8629  — NOT suppressed: real unboxing/.Value crash detection active
    -->
    <NoWarn>$(NoWarn);CS8619;CS8620;CS8765;CS0414;CS0169;CS8600;CS8601;CS8603;CS8604;CS8618;CS8625;CS0649;CS0108;CS0114;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Godot C# Sources -->
    <Compile Include="src/**/*.cs" Exclude="src/bin/**;src/obj/**" />
    <!--
      Engine-agnostic core. Single shared source tree compiled into this Godot
      host and the xUnit test project. Do not copy core sources elsewhere.
    -->
    <Compile Include="Assets/Ashfall.Core/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(AshfallIncludeSelfTests)' != 'true'">
    <Compile Remove="src/Main.UiTests*.cs;src/**/HostCli.*.cs;src/**/*SelfTest.cs;src/**/*SelfTests.cs;src/Main.WorldPlaytest.cs;src/Host/SevenDayDeterministicSmokeTest.cs;src/CSharpVerificationTest.cs;src/UI/SnapshotHarness.cs;src/UI/SnapshotOrchestrator.cs;src/Host/AssetCoverageScanner.cs;src/Host/AssetCoverageReport.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sentry" />
  </ItemGroup>
</Project>

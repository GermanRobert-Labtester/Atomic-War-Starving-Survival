<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>AtomicWar</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!--
      Remaining suppressed warnings (narrowed from original 19):
      CS0108/CS0114  — intentional member hiding in host sessions
      CS0414         — serializer-assigned fields flagged as unused
      CS0067         — public event surface wired by feature registration
      CS8600/CS8601  — JSON-populated DTO null conversions (known safe)
      CS8604/CS8618  — serializer-assigned reference fields
      CS8625         — null passed to non-nullable param in JSON paths
      CS8765         — interface/override nullability mismatch on DTOs
      CS8619/CS8620  — tuple nullability drift in host adapters
      CS0649/CS0169  — fields only written by JSON serializer
      CS8602/CS8603  — NOT suppressed: real null-dereference detection active
      CS8605/CS8629  — NOT suppressed: real unboxing/.Value crash detection active
    -->
    <NoWarn>$(NoWarn);CS8619;CS8620;CS8765;CS0414;CS0169;CS8600;CS8601;CS8603;CS8604;CS8618;CS8625;CS0649;CS0108;CS0114;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Godot C# Sources -->
    <Compile Include="src/**/*.cs" Exclude="src/bin/**;src/obj/**" />
    <!--
      Engine-agnostic core. Single shared source tree compiled into this Godot
      host and the xUnit test project. Do not copy core sources elsewhere.
    -->
    <Compile Include="Assets/Ashfall.Core/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sentry" Version="6.9.0" />
  </ItemGroup>
</Project>

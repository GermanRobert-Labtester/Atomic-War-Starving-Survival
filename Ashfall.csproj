<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>AtomicWar</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!--
      Unity legacy code is compiled here via the shim and is not nullable-analyzed
      by Unity itself; tuple nullability drift (CS8619/CS8620) and serializer-/
      inspector-populated fields (CS0649/CS0169) are expected noise. CS8605/CS8629
      are NOT suppressed: they flag real unboxing/.Value crash risks.
    -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0414;CS0067;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8765;CS8619;CS8620;CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Godot C# Sources -->
    <Compile Include="src/**/*.cs" Exclude="src/bin/**;src/obj/**" />
    <Compile Include="scripts/**/*.cs" Exclude="scripts/bin/**;scripts/obj/**" />
    <!--
      Engine-agnostic core. Single shared source tree compiled into this Godot
      host and the xUnit test project. Do not copy core sources elsewhere.
    -->
    <Compile Include="Assets/Ashfall.Core/**/*.cs" />
  </ItemGroup>
</Project>
